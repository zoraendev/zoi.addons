<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_prodigyn.FormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <div class="zrn_prodigyn_cp_actions">
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_blue" t-on-click="openButton1">Boton 1</button>
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_blue" t-on-click="openButton2">Boton 2</button>
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_blue" t-on-click="openButton3">Boton 3</button>
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_blue" t-on-click="openButton4">Boton 4</button>
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_blue" t-on-click="openButton5">Boton 5</button>
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_dark" t-on-click="openSupport">Open Support</button>
                    <button type="button" class="btn zrn_prodigyn_cp_btn zrn_prodigyn_cp_btn_dark" t-on-click="openProdigynGo">Prodigyn Go</button>
                </div>
            </t>
        </xpath>
    </t>
</templates>
