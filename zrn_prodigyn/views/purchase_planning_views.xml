<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_purchase_planning_default" model="zrn_prodigyn.purchase.planning">
        <field name="name">Planeacion de Abastecimiento</field>
    </record>

    <record id="view_zrn_prodigyn_purchase_planning_filter_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.planning.wizard.form</field>
        <field name="model">zrn_prodigyn.purchase.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Planeacion de abastecimiento" create="0" delete="0" duplicate="0" class="zrn_prodigyn_filter_form">
                <sheet>
                    <header>
                        <div class="zrn_prodigyn_filter_footer">
                            <div class="zrn_prodigyn_filter_footer_start">
                                <button
                                    name="action_back_to_production_planning"
                                    type="object"
                                    string="Regresar"
                                    icon="fa-arrow-left"
                                    class="btn zrn_prodigyn_back_btn"
                                />
                            </div>
                        </div>
                    </header>

                    <group invisible="1">
                        <field name="name"/>
                        <field name="available_supply_product_ids"/>
                        <field name="planning_record_count"/>
                    </group>

                    <div class="zrn_prodigyn_filter_page">
                        <div class="zrn_prodigyn_filter_panel">
                            <div class="zrn_prodigyn_filter_panel_head">
                                <div>
                                    <h2>Filtros para abastecimiento</h2>
                                </div>
                            </div>

                            <group class="zrn_prodigyn_filter_fields">
                                <group>
                                    <field name="fecha_desde"/>
                                    <field name="fecha_hasta"/>
                                    <field name="planning_basis" widget="radio"/>
                                    <field name="mrp_source_state" invisible="planning_basis != 'mrp'"/>
                                    <field name="sale_source_state" invisible="planning_basis != 'sale'"/>
                                </group>
                                <group>
                                    <field
                                        name="supply_product_ids"
                                        widget="many2many_tags"
                                        domain="[('id', 'in', available_supply_product_ids)]"
                                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                        string="Insumos"
                                        placeholder="Selecciona uno o varios insumos"
                                    />
                                </group>
                            </group>

                            <div class="zrn_prodigyn_filter_snapshot">
                                <div class="zrn_prodigyn_filter_snapshot_title">Resumen</div>
                                <group class="zrn_prodigyn_filter_snapshot_grid">
                                    <group>
                                        <field name="preview_supply_product_count" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="preview_bom_count" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="preview_source_count" readonly="1"/>
                                    </group>
                                </group>
                            </div>

                            <div class="zrn_prodigyn_filter_actions_bottom">
                                <button
                                    name="action_clear_filters"
                                    type="object"
                                    string="Limpiar"
                                    class="btn zrn_prodigyn_filter_btn zrn_prodigyn_filter_btn_secondary"
                                />
                                <button
                                    name="action_continue"
                                    type="object"
                                    string="Continuar"
                                    class="btn zrn_prodigyn_filter_btn zrn_prodigyn_filter_btn_primary"
                                />
                            </div>
                        </div>

                        <div class="zrn_prodigyn_filter_table_panel">
                            <div class="zrn_prodigyn_filter_table_head">
                                <div>
                                    <h2>Planes creados</h2>
                                </div>
                            </div>
                            <div class="zrn_prodigyn_filter_snapshot">
                                <div class="zrn_prodigyn_filter_snapshot_title">Total</div>
                                <group class="zrn_prodigyn_filter_snapshot_grid">
                                    <group>
                                        <field name="planning_record_count" readonly="1"/>
                                    </group>
                                </group>
                            </div>
                            <div class="zrn_prodigyn_filter_actions_bottom">
                                <button
                                    name="action_open_existing_plans"
                                    type="object"
                                    string="Ver planes"
                                    class="btn zrn_prodigyn_filter_btn zrn_prodigyn_filter_btn_secondary"
                                />
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zrn_prodigyn_purchase_planning_report_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.planning.wizard.report.form</field>
        <field name="model">zrn_prodigyn.purchase.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Planeacion de abastecimiento" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_production_report_form">
                <sheet>
                    <group invisible="1">
                        <field name="report_ready"/>
                        <field name="report_active_tab"/>
                        <field name="report_requirement_line_ids"/>
                        <field name="report_supply_line_ids"/>
                        <field name="report_product_line_ids"/>
                        <field name="report_document_line_ids"/>
                        <field name="report_date_range_mode"/>
                        <field name="report_date_from_label"/>
                        <field name="report_date_to_label"/>
                    </group>
                    <div class="zrn_prodigyn_production_report_screen">
                        <div class="zrn_prodigyn_production_report_header_shell">
                            <div class="zrn_prodigyn_production_report_header">
                                <div class="zrn_prodigyn_production_report_heading_group">
                                    <button
                                        name="action_back_to_filters"
                                        type="object"
                                        string="Regresar"
                                        icon="fa-arrow-left"
                                        class="btn zrn_prodigyn_back_btn zrn_prodigyn_report_back_inline"
                                    />
                                    <button name="action_open_report_overview" type="object" class="btn zrn_prodigyn_production_report_title_tab" invisible="report_active_tab != 'overview'">
                                        Detalle operativo de abastecimiento
                                    </button>
                                    <button name="action_open_report_overview" type="object" class="btn zrn_prodigyn_production_report_title_tab zrn_prodigyn_production_report_title_tab_inactive" invisible="report_active_tab == 'overview'">
                                        Detalle operativo de abastecimiento
                                    </button>
                                </div>
                                <div class="zrn_prodigyn_production_report_header_range">
                                    <span>Rango consultado:</span>
                                    <strong invisible="report_date_range_mode != 'range'">
                                        <field name="report_date_from_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <span invisible="report_date_range_mode != 'range'">al</span>
                                    <strong invisible="report_date_range_mode != 'range'">
                                        <field name="report_date_to_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <strong invisible="report_date_range_mode != 'from'">
                                        desde <field name="report_date_from_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <strong invisible="report_date_range_mode != 'to'">
                                        hasta <field name="report_date_to_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <strong invisible="report_date_range_mode != 'all'">
                                        <field name="report_date_range_label" readonly="1" nolabel="1"/>
                                    </strong>
                                </div>
                                <div class="zrn_prodigyn_production_report_actions">
                                    <button name="action_open_report_supplies_list" type="object" class="btn zrn_prodigyn_production_report_action_btn" invisible="report_active_tab != 'supplies'">
                                        <i class="fa fa-cubes"/>
                                        <span>Insumos:</span>
                                        <strong><field name="report_supply_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_supplies" type="object" class="btn zrn_prodigyn_production_report_action_btn zrn_prodigyn_production_report_action_btn_inactive" invisible="report_active_tab == 'supplies'">
                                        <i class="fa fa-cubes"/>
                                        <span>Insumos:</span>
                                        <strong><field name="report_supply_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_products_list" type="object" class="btn zrn_prodigyn_production_report_action_btn" invisible="report_active_tab != 'products'">
                                        <i class="fa fa-industry"/>
                                        <span>Productos:</span>
                                        <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_products" type="object" class="btn zrn_prodigyn_production_report_action_btn zrn_prodigyn_production_report_action_btn_inactive" invisible="report_active_tab == 'products'">
                                        <i class="fa fa-industry"/>
                                        <span>Productos:</span>
                                        <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_documents_list" type="object" class="btn zrn_prodigyn_production_report_action_btn" invisible="report_active_tab != 'documents'">
                                        <i class="fa fa-file-text-o"/>
                                        <span>Ordenes:</span>
                                        <strong><field name="report_document_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_documents" type="object" class="btn zrn_prodigyn_production_report_action_btn zrn_prodigyn_production_report_action_btn_inactive" invisible="report_active_tab == 'documents'">
                                        <i class="fa fa-file-text-o"/>
                                        <span>Ordenes:</span>
                                        <strong><field name="report_document_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <div class="zrn_prodigyn_production_report_inline_stat">
                                        <i class="fa fa-list-ul"/>
                                        <span>Lineas:</span>
                                        <strong><field name="report_row_count" readonly="1" nolabel="1"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="zrn_prodigyn_production_report_table_panel">
                            <div class="zrn_prodigyn_production_report_table_toolbar">
                                <button name="action_open_report_supplies_list" type="object"
                                        class="btn zrn_prodigyn_production_report_table_toolbar_btn zrn_prodigyn_production_report_table_toolbar_btn_primary"
                                        invisible="report_active_tab != 'supplies'">
                                    <i class="fa fa-check-square-o" style='margin-right:4px;'/>
                                    <span>Seleccionar y exportar</span>
                                </button>
                                <button name="action_open_report_products_list" type="object"
                                        class="btn zrn_prodigyn_production_report_table_toolbar_btn zrn_prodigyn_production_report_table_toolbar_btn_primary"
                                        invisible="report_active_tab != 'products'">
                                    <i class="fa fa-check-square-o" style='margin-right:4px;'/>
                                    <span>Seleccionar y exportar</span>
                                </button>
                                <button name="action_open_report_documents_list" type="object"
                                        class="btn zrn_prodigyn_production_report_table_toolbar_btn zrn_prodigyn_production_report_table_toolbar_btn_primary"
                                        invisible="report_active_tab != 'documents'">
                                    <i class="fa fa-check-square-o" style='margin-right:4px;'/>
                                    <span>Seleccionar y exportar</span>
                                </button>
                            </div>
                            <div class="zrn_prodigyn_production_report_table_placeholder">
                                <div class="zrn_prodigyn_production_report_table_placeholder_title" invisible="report_active_tab != 'overview'">Espacio reservado para la tabla del reporte</div>
                                <div class="zrn_prodigyn_production_report_table_placeholder_body" invisible="report_active_tab != 'overview'"/>
                                <div invisible="report_active_tab != 'supplies'">
                                    <field name="report_supply_line_ids" readonly="1" nolabel="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="first_required_date"/>
                                            <field name="last_required_date"/>
                                            <field name="component_id" string="Insumo"/>
                                            <field name="default_code"/>
                                            <field name="categ_name"/>
                                            <field name="document_count"/>
                                            <field name="product_count"/>
                                            <field name="line_count"/>
                                            <field name="total_required_qty" sum="Total requerido"/>
                                            <field name="stock_initial" sum="Stock inicial"/>
                                            <field name="stock_free" sum="Stock libre"/>
                                            <field name="suggested_purchase_qty" sum="Compra sugerida"/>
                                        </tree>
                                    </field>
                                </div>
                                <div invisible="report_active_tab != 'products'">
                                    <field name="report_product_line_ids" readonly="1" nolabel="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="first_required_date"/>
                                            <field name="last_required_date"/>
                                            <field name="product_id" string="Producto"/>
                                            <field name="default_code"/>
                                            <field name="categ_name"/>
                                            <field name="document_count"/>
                                            <field name="component_count"/>
                                            <field name="line_count"/>
                                            <field name="planned_qty" sum="Cantidad planeada"/>
                                        </tree>
                                    </field>
                                </div>
                                <div invisible="report_active_tab != 'documents'">
                                    <field name="report_document_line_ids" readonly="1" nolabel="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="first_required_date"/>
                                            <field name="last_required_date"/>
                                            <field name="source_type_label" string="Tipo"/>
                                            <field name="source_reference" string="Documento"/>
                                            <field name="customer_id" string="Punto de venta"/>
                                            <field name="state_label" string="Estado"/>
                                            <field name="product_count"/>
                                            <field name="line_count"/>
                                            <field name="planned_qty" sum="Cantidad planeada"/>
                                        </tree>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zrn_prodigyn_purchase_report_supply_tree" model="ir.ui.view">
