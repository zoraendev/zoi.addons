    </record>

    <record id="view_zrn_prodigyn_purchase_report_document_tree" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.report.document.tree</field>
        <field name="model">zrn_prodigyn.purchase.planning.wizard.report.document.line</field>
        <field name="arch" type="xml">
            <tree string="Ordenes del reporte" create="0" edit="0" delete="0" import="0" js_class="zrn_prodigyn_report_summary_list">
                <field name="first_required_date"/>
                <field name="last_required_date"/>
                <field name="source_type_label" string="Tipo"/>
                <field name="source_reference" string="Documento"/>
                <field name="customer_id" string="Punto de venta"/>
                <field name="state_label" string="Estado"/>
                <field name="product_count"/>
                <field name="line_count"/>
                <field name="planned_qty" sum="Cantidad planeada"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_prodigyn_purchase_report_document_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.report.document.form</field>
        <field name="model">zrn_prodigyn.purchase.planning.wizard.report.document.line</field>
        <field name="arch" type="xml">
            <form string="Detalle del documento" create="0" edit="0" delete="0" class="zrn_prodigyn_report_detail_form">
                <sheet>
                    <group invisible="1">
                        <field name="report_detail_requirement_line_ids"/>
                    </group>
                    <div class="zrn_prodigyn_report_detail_overview zrn_prodigyn_report_detail_overview_single">
                        <div class="zrn_prodigyn_report_detail_top zrn_prodigyn_report_detail_top_no_media">
                            <div class="zrn_prodigyn_report_detail_heading">
                                <div class="oe_title">
                                    <h1><field name="source_reference" readonly="1" nolabel="1"/></h1>
                                </div>
                                <div class="text-muted zrn_prodigyn_report_detail_subtitle">
                                    <field name="source_type_label" readonly="1" nolabel="1"/>
                                    <span invisible="not customer_id"> | </span>
                                    <field name="customer_id" readonly="1" nolabel="1" invisible="not customer_id"/>
                                    <span> | </span>
                                    <field name="state_label" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="zrn_prodigyn_report_detail_stats">
                            <div class="zrn_prodigyn_report_detail_stat"><span>Primera fecha</span><strong><field name="first_required_date" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Ultima fecha</span><strong><field name="last_required_date" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Productos</span><strong><field name="product_count" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Lineas</span><strong><field name="line_count" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Cantidad planeada</span><strong><field name="planned_qty" readonly="1" nolabel="1"/></strong></div>
                        </div>
                    </div>
                    <div class="zrn_prodigyn_report_detail_lines_group">
                        <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">Lineas incluidas</div>
                        <field name="report_detail_requirement_line_ids" readonly="1" nolabel="1"
                               context="{'form_view_ref': 'zrn_prodigyn.view_zrn_prodigyn_purchase_requirement_line_modal_form'}">
                            <tree create="0" edit="0" delete="0">
                                <field name="finished_product_id" string="Producto"/>
                                <field name="component_id" string="Insumo"/>
                                <field name="required_qty" string="Requerido"/>
                                <field name="stock_free" string="Stock libre"/>
                                <field name="suggested_purchase_qty" string="Compra sugerida"/>
                            </tree>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zrn_prodigyn_purchase_requirement_line_modal_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.requirement.line.modal.form</field>
        <field name="model">zrn_prodigyn.purchase.planning.wizard.report.requirement.line</field>
        <field name="arch" type="xml">
            <form string="Linea incluida" edit="false" create="0" delete="0" class="zrn_prodigyn_report_line_detail_form">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="source_reference" readonly="1" nolabel="1"/></h1>
                    </div>
                    <div class="zrn_prodigyn_report_line_detail_grid">
                        <div class="zrn_prodigyn_report_line_detail_col">
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Tipo de documento</span>
                                <strong><field name="source_type_label" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Producto terminado</span>
                                <strong><field name="finished_product_id" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Insumo</span>
                                <strong><field name="component_id" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item" invisible="not customer_id">
                                <span>Punto de venta</span>
                                <strong><field name="customer_id" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Estado</span>
                                <strong><field name="source_state_label" readonly="1" nolabel="1"/></strong>
                            </div>
                        </div>
                        <div class="zrn_prodigyn_report_line_detail_col">
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Fecha base</span>
                                <strong><field name="schedule_date" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Cantidad planeada</span>
                                <strong><field name="planned_qty" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Cantidad requerida</span>
                                <strong><field name="required_qty" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Stock inicial</span>
                                <strong><field name="stock_initial" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Stock libre</span>
                                <strong><field name="stock_free" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_report_line_detail_item">
                                <span>Compra sugerida</span>
                                <strong><field name="suggested_purchase_qty" readonly="1" nolabel="1"/></strong>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_purchase_report_documents" model="ir.actions.act_window">
        <field name="name">Ordenes del reporte</field>
        <field name="res_model">zrn_prodigyn.purchase.planning.wizard.report.document.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="zrn_prodigyn.view_zrn_prodigyn_purchase_report_document_tree"/>
        <field name="domain">[('wizard_id', '=', context.get('active_id'))]</field>
        <field name="target">current</field>
    </record>

    <record id="view_zrn_prodigyn_purchase_planning_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.planning.form</field>
        <field name="model">zrn_prodigyn.purchase.planning</field>
        <field name="arch" type="xml">
            <form string="Planeacion de Abastecimiento" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_purchase_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Prodigyn"
                            class="btn zrn_prodigyn_back_btn"
