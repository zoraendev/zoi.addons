                <field name="first_required_date"/>
                <field name="last_required_date"/>
                <field name="component_id" string="Insumo"/>
                <field name="default_code"/>
                <field name="categ_name"/>
                <field name="document_count"/>
                <field name="product_count"/>
                <field name="line_count"/>
                <field name="total_required_qty" sum="Total requerido"/>
                <field name="stock_initial" sum="Stock inicial"/>
                <field name="stock_free" sum="Stock libre"/>
                <field name="suggested_purchase_qty" sum="Compra sugerida"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_prodigyn_purchase_report_supply_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.report.supply.form</field>
        <field name="model">zrn_prodigyn.purchase.planning.wizard.report.supply.line</field>
        <field name="arch" type="xml">
            <form string="Detalle del insumo" create="0" edit="0" delete="0" class="zrn_prodigyn_report_detail_form">
                <sheet>
                    <group invisible="1">
                        <field name="component_image_1920"/>
                        <field name="report_detail_requirement_line_ids"/>
                    </group>
                    <div class="zrn_prodigyn_report_detail_overview">
                        <div class="zrn_prodigyn_report_detail_top">
                            <div class="zrn_prodigyn_report_detail_media">
                                <field name="component_image_1920" widget="image" class="oe_avatar"
                                       options="{'preview_image': 'component_image_1920'}" nolabel="1"/>
                            </div>
                            <div class="zrn_prodigyn_report_detail_heading">
                                <div class="oe_title">
                                    <h1><field name="component_id" readonly="1" nolabel="1"/></h1>
                                </div>
                                <div class="text-muted zrn_prodigyn_report_detail_subtitle">
                                    <field name="default_code" readonly="1" nolabel="1"/>
                                    <span> | </span>
                                    <field name="categ_name" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="zrn_prodigyn_report_detail_stats">
                            <div class="zrn_prodigyn_report_detail_stat"><span>Primera fecha</span><strong><field name="first_required_date" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Ultima fecha</span><strong><field name="last_required_date" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Ordenes</span><strong><field name="document_count" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Productos</span><strong><field name="product_count" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Lineas</span><strong><field name="line_count" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Requerido total</span><strong><field name="total_required_qty" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Stock inicial</span><strong><field name="stock_initial" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Stock libre</span><strong><field name="stock_free" readonly="1" nolabel="1"/></strong></div>
                            <div class="zrn_prodigyn_report_detail_stat"><span>Compra sugerida</span><strong><field name="suggested_purchase_qty" readonly="1" nolabel="1"/></strong></div>
                        </div>
                    </div>
                    <div class="zrn_prodigyn_report_detail_lines_group">
                        <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">Lineas incluidas</div>
                        <field name="report_detail_requirement_line_ids" readonly="1" nolabel="1"
                               context="{'form_view_ref': 'zrn_prodigyn.view_zrn_prodigyn_purchase_requirement_line_modal_form'}">
                            <tree create="0" edit="0" delete="0">
                                <field name="schedule_date"/>
                                <field name="source_reference" string="Documento"/>
                                <field name="finished_product_id" string="Producto"/>
                                <field name="customer_id" string="Punto de venta"/>
                                <field name="planned_qty" string="Cantidad planeada"/>
                                <field name="required_qty" string="Requerido"/>
                                <field name="suggested_purchase_qty" string="Compra sugerida"/>
                            </tree>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

