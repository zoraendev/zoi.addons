<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_purchase_planning_default" model="zrn_prodigyn.purchase.planning">
        <field name="name">Planeacion de Abastecimiento</field>
    </record>

    <record id="view_zrn_prodigyn_purchase_planning_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.purchase.planning.form</field>
        <field name="model">zrn_prodigyn.purchase.planning</field>
        <field name="arch" type="xml">
            <form string="Planeacion de Abastecimiento" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_purchase_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Prodigyn"
                            class="btn zrn_prodigyn_back_btn"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>Planeacion de Abastecimiento</h1>
                    </div>
                    <div class="zrn_prodigyn_building_state">
                        <div class="zrn_prodigyn_building_loader" aria-hidden="true">
                            <span class="zrn_prodigyn_building_loader_ring zrn_prodigyn_building_loader_ring_outer"/>
                            <span class="zrn_prodigyn_building_loader_ring zrn_prodigyn_building_loader_ring_inner"/>
                            <span class="zrn_prodigyn_building_loader_core"/>
                        </div>
                        <div class="zrn_prodigyn_building_copy">
                            <div class="zrn_prodigyn_building_kicker">Workspace en progreso</div>
                            <div class="zrn_prodigyn_building_title">Estamos preparando esta vista</div>
                            <div class="zrn_prodigyn_building_messages" aria-live="polite">
                                <span>Construyendo el tablero de abastecimiento...</span>
                                <span>Conectando compras, materiales e inventario...</span>
                                <span>Armando accesos, indicadores y seguimiento operativo...</span>
                                <span>Dejando lista la experiencia para esta pantalla...</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_purchase_planning" model="ir.actions.act_window">
        <field name="name">Planeacion de Abastecimiento</field>
        <field name="res_model">zrn_prodigyn.purchase.planning</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_purchase_planning_form"/>
        <field name="res_id" ref="zrn_prodigyn_purchase_planning_default"/>
        <field name="target">current</field>
    </record>

</odoo>
