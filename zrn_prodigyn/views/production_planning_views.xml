    <record id="view_zrn_prodigyn_production_planning_filter_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.production.planning.wizard.form</field>
        <field name="model">zrn_prodigyn.production.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Planeacion de fabricacion" create="0" delete="0" duplicate="0" class="zrn_prodigyn_filter_form">
                <sheet>
                    <header>
                        <div class="zrn_prodigyn_filter_footer">
                            <div class="zrn_prodigyn_filter_footer_start">
                                <button
                                    name="action_back_to_production_planning"
                                    type="object"
                                    string="Regresar"
                                    icon="fa-arrow-left"
                                    class="btn zrn_prodigyn_back_btn"
                                />
                            </div>
                            <div class="zrn_prodigyn_filter_footer_end">
                                <button name="action_clear_filters" type="object" string="Limpiar" class="btn btn-secondary"/>
                                <button name="action_continue" type="object" string="Continuar" class="btn btn-primary"/>
                            </div>
                        </div>
                    </header>
                    <group invisible="1">
                        <field name="name"/>
                        <field name="available_cliente_ids"/>
                        <field name="available_product_ids"/>
                    </group>

                    <group string="Filtros para fabricacion">
                        <group>
                            <field name="fecha_entrega_desde"/>
                            <field name="fecha_entrega_hasta"/>
                        </group>
                        <group>
                            <field
                                name="cliente_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', available_cliente_ids)]"
                                context="{'show_address': 1, 'show_vat': True}"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                string="Puntos de venta"
                                placeholder="Selecciona uno o varios puntos de venta"
                            />
                            <field
                                name="product_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', available_product_ids)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                placeholder="Selecciona uno o varios productos"
                            />
                        </group>
                    </group>

                    <group string="Seleccion actual">
                        <group>
                            <field name="preview_order_count" readonly="1"/>
                            <field name="preview_cliente_count" readonly="1"/>
                            <field name="preview_product_count" readonly="1"/>
                        </group>
                    </group>
                   
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zrn_prodigyn_production_planning_report_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.production.planning.wizard.report.form</field>
        <field name="model">zrn_prodigyn.production.planning.wizard</field>
        <field name="arch" type="xml">
            <form string="Planeacion de fabricacion" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_production_report_form">
                <sheet>
                    <group invisible="1">
                        <field name="report_ready"/>
                        <field name="report_active_tab"/>
                        <field name="report_customer_line_ids"/>
                        <field name="report_product_line_ids"/>
                        <field name="report_order_line_ids"/>
                        <field name="report_date_range_mode"/>
                        <field name="report_date_from_label"/>
                        <field name="report_date_to_label"/>
                    </group>
                    <div class="zrn_prodigyn_production_report_screen">
                        <div class="zrn_prodigyn_production_report_header_shell">
                            <div class="zrn_prodigyn_production_report_header">
                                <div class="zrn_prodigyn_production_report_heading_group">
                                    <button
                                        name="action_back_to_filters"
                                        type="object"
                                        string="Regresar"
                                        icon="fa-arrow-left"
                                        class="btn zrn_prodigyn_back_btn zrn_prodigyn_report_back_inline"
                                    />
                                    <button name="action_open_report_overview" type="object" class="btn zrn_prodigyn_production_report_title_tab" invisible="report_active_tab != 'overview'">
                                        Detalle operativo de fabricacion
                                    </button>
                                    <button name="action_open_report_overview" type="object" class="btn zrn_prodigyn_production_report_title_tab zrn_prodigyn_production_report_title_tab_inactive" invisible="report_active_tab == 'overview'">
                                        Detalle operativo de fabricacion
                                    </button>
                                </div>
                                <div class="zrn_prodigyn_production_report_header_range">
                                    <span>Rango consultado:</span>
                                    <strong invisible="report_date_range_mode != 'range'">
                                        <field name="report_date_from_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <span invisible="report_date_range_mode != 'range'">al</span>
                                    <strong invisible="report_date_range_mode != 'range'">
                                        <field name="report_date_to_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <strong invisible="report_date_range_mode != 'from'">
                                        desde <field name="report_date_from_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <strong invisible="report_date_range_mode != 'to'">
                                        hasta <field name="report_date_to_label" readonly="1" nolabel="1"/>
                                    </strong>
                                    <strong invisible="report_date_range_mode != 'all'">
                                        <field name="report_date_range_label" readonly="1" nolabel="1"/>
                                    </strong>
                                </div>
                                <div class="zrn_prodigyn_production_report_actions">
                                    <button name="action_open_report_customers" type="object" class="btn zrn_prodigyn_production_report_action_btn" invisible="report_active_tab != 'customers'">
                                        <i class="fa fa-users"/>
                                        <span>Clientes</span>
                                        <strong><field name="report_customer_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_customers" type="object" class="btn zrn_prodigyn_production_report_action_btn zrn_prodigyn_production_report_action_btn_inactive" invisible="report_active_tab == 'customers'">
                                        <i class="fa fa-users"/>
                                        <span>Clientes</span>
                                        <strong><field name="report_customer_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_products" type="object" class="btn zrn_prodigyn_production_report_action_btn" invisible="report_active_tab != 'products'">
                                        <i class="fa fa-cubes"/>
                                        <span>Productos</span>
                                        <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_products" type="object" class="btn zrn_prodigyn_production_report_action_btn zrn_prodigyn_production_report_action_btn_inactive" invisible="report_active_tab == 'products'">
                                        <i class="fa fa-cubes"/>
                                        <span>Productos</span>
                                        <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_orders" type="object" class="btn zrn_prodigyn_production_report_action_btn" invisible="report_active_tab != 'orders'">
                                        <i class="fa fa-file-text-o"/>
                                        <span>OVs</span>
                                        <strong><field name="report_order_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <button name="action_open_report_orders" type="object" class="btn zrn_prodigyn_production_report_action_btn zrn_prodigyn_production_report_action_btn_inactive" invisible="report_active_tab == 'orders'">
                                        <i class="fa fa-file-text-o"/>
                                        <span>OVs</span>
                                        <strong><field name="report_order_count" readonly="1" nolabel="1"/></strong>
                                    </button>
                                    <div class="zrn_prodigyn_production_report_inline_stat zrn_prodigyn_production_report_inline_stat_tooltip">
                                        <i class="fa fa-list-ul"/>
                                        <span>Lineas</span>
                                        <strong><field name="report_row_count" readonly="1" nolabel="1"/></strong>
                                        <span class="zrn_prodigyn_production_report_tooltip_body">
                                            Cada linea representa una linea de pedido incluida en la consulta, segun el producto, la OV y el punto de venta pendiente de entregar.
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="zrn_prodigyn_production_report_table_panel">
                            <div class="zrn_prodigyn_production_report_table_placeholder">
                                <div class="zrn_prodigyn_production_report_table_placeholder_title" invisible="report_active_tab != 'overview'">Espacio reservado para la tabla del reporte</div>
                                <div class="zrn_prodigyn_production_report_table_placeholder_body" invisible="report_active_tab != 'overview'"/>
                                <div invisible="report_active_tab != 'customers'">
                                    <field name="report_customer_line_ids" readonly="1" nolabel="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="first_delivery_date"/>
                                            <field name="last_delivery_date"/>
                                            <field name="partner_id" string="Punto de venta"/>
                                            <field name="customer_id" string="Cliente"/>
                                            <field name="city"/>
                                            <field name="order_count"/>
                                            <field name="line_count"/>
                                            <field name="product_count"/>
                                            <field name="total_units" sum="Total unidades"/>
                                        </tree>
                                    </field>
                                </div>
                                <div invisible="report_active_tab != 'products'">
                                    <field name="report_product_line_ids" readonly="1" nolabel="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="first_delivery_date"/>
                                            <field name="last_delivery_date"/>
                                            <field name="product_id" string="Producto"/>
                                            <field name="default_code"/>
                                            <field name="categ_name"/>
                                            <field name="customer_count"/>
                                            <field name="order_count"/>
                                            <field name="line_count"/>
                                            <field name="total_units" sum="Total demanda"/>
                                            <field name="stock_initial" sum="Stock inicial"/>
                                            <field name="stock_free" sum="Stock libre"/>
                                        </tree>
                                    </field>
                                </div>
                                <div invisible="report_active_tab != 'orders'">
                                    <field name="report_order_line_ids" readonly="1" nolabel="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="first_delivery_date"/>
                                            <field name="last_delivery_date"/>
                                            <field name="order_id"/>
                                            <field name="customer_id" string="Punto de venta"/>
                                            <field name="state_label" string="Estado"/>
                                            <field name="product_count"/>
                                            <field name="line_count"/>
                                            <field name="total_units" sum="Total unidades"/>
                                        </tree>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_back_to_filters" type="object" string="Volver a filtros" class="btn btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zrn_prodigyn_production_report_customer_tree" model="ir.ui.view">
