<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_inicio_default" model="zrn_prodigyn.inicio">
        <field name="name">Prodigyn</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="zrn_prodigyn_inicio_secondary_default" model="zrn_prodigyn.inicio">
        <field name="name">Prodigyn</field>
        <field name="sequence">20</field>
        <field name="page_key">workspace</field>
    </record>

    <record id="view_zrn_prodigyn_inicio_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.inicio.form</field>
        <field name="model">zrn_prodigyn.inicio</field>
        <field name="arch" type="xml">
            <form string="Prodigyn" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_home_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                    <field name="show_dashboard" invisible="1"/>
                    <field name="client_validation_state" invisible="1"/>
                    <field name="client_status_code" invisible="1"/>
                    <field name="support_url" invisible="1"/>
                    <field name="client_validation_debug" invisible="1"/>

                    <div class="zrn_advanced_metrics_dashboard" invisible="show_dashboard">
                        <div class="zrn_am_blocked_state">
                            <div class="alert zrn_am_blocked_banner" role="alert">
                                <div class="zrn_am_blocked_banner_content">
                                    <h3>
                                        <field name="client_status_title" readonly="1" nolabel="1" class="oe_inline"/>
                                    </h3>
                                    <p>
                                        <field name="client_status_message" readonly="1" nolabel="1" class="oe_inline"/>
                                    </p>
                                    <p class="text-muted" invisible="not client_status_code">
                                        Codigo: <field name="client_status_code" readonly="1" nolabel="1" class="oe_inline"/>
                                    </p>
                                    <p class="text-muted" invisible="not client_validation_debug">
                                        <field name="client_validation_debug" readonly="1" nolabel="1" class="oe_inline"/>
                                    </p>
                                    <div class="zrn_advanced_metrics_tile_actions zrn_am_center_actions">
                                        <button
                                            name="action_open_settings_dashboard"
                                            type="object"
                                            string="Abrir configuracion"
                                            class="btn btn-primary"
                                        />
                                        <button
                                            name="action_open_support"
                                            type="object"
                                            string="Contactar soporte"
                                            class="btn btn-secondary"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="zrn_prodigyn_home_shell" invisible="page_key != 'overview' or not show_dashboard">
                        <div class="zrn_prodigyn_home_hero">
                            <div class="zrn_prodigyn_home_hero_copy">
                                <div class="zrn_prodigyn_home_kicker">Centro operativo</div>
                                <div class="oe_title zrn_prodigyn_home">
                                    <h1>Bienvenido a Prodigyn</h1>
                                </div>
                                <div class="zrn_prodigyn_home_intro">
                                    Suite de planeacion operativa para coordinar demanda, produccion, abastecimiento, logistica y recursos desde Odoo.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_home_quickstats">
                                <div class="zrn_prodigyn_home_stat">
                                    <span class="zrn_prodigyn_home_stat_label">Pendientes</span>
                                    <span class="zrn_prodigyn_home_stat_value">08</span>
                                </div>
                                <div class="zrn_prodigyn_home_stat">
                                    <span class="zrn_prodigyn_home_stat_label">Alertas</span>
                                    <span class="zrn_prodigyn_home_stat_value">03</span>
                                </div>
                                <div class="zrn_prodigyn_home_stat">
                                    <span class="zrn_prodigyn_home_stat_label">Puntos activos</span>
                                    <span class="zrn_prodigyn_home_stat_value">24</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_home_dashboard">
                            <div class="zrn_prodigyn_home_modules">
                                <div class="zrn_prodigyn_home_section_title">Modulos de planeacion</div>
                                <div class="zrn_prodigyn_home_menu">
                                    <button
                                        name="action_open_summary"
                                        type="object"
                                        icon="fa-dashboard"
                                        string="Resumen General"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"
                                    />
                                    <button
                                        name="action_open_commercial_planning"
                                        type="object"
                                        icon="fa-line-chart"
                                        string="Planeacion Comercial"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"
                                    />
                                    <button
                                        name="action_open_production_planning"
                                        type="object"
                                        icon="fa-industry"
                                        string="Planeacion de Produccion"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_secondary"
                                    />
                                    <button
                                        name="action_open_supply_planning"
                                        type="object"
                                        icon="fa-shopping-cart"
                                        string="Planeacion de Abastecimiento"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"
                                    />
                                    <button
                                        name="action_open_logistics_planning"
                                        type="object"
                                        icon="fa-truck"
                                        string="Planeacion Logistica"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"
                                    />
                                    <button
                                        name="action_open_resource_planning"
                                        type="object"
                                        icon="fa-users"
                                        string="Planeacion de Recursos"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"
                                    />
                                    <button
                                        name="action_open_scenarios"
                                        type="object"
                                        icon="fa-random"
                                        string="Escenarios y Simulaciones"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"
                                    />
                                    <button
                                        name="action_open_reporting"
                                        type="object"
                                        icon="fa-bar-chart"
                                        string="Reporteria y Analisis"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"
                                    />
                                    <button
                                        name="action_open_settings_dashboard"
                                        type="object"
                                        icon="fa-cog"
                                        string="Configuracion"
                                        class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"
                                    />
                                </div>
                            </div>

                            <div class="zrn_prodigyn_home_previews">
                                <div class="zrn_prodigyn_home_panel zrn_prodigyn_home_panel_wide">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Agenda operativa</span>
                                        <span>Semana actual</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_calendar">
                                        <div class="zrn_prodigyn_home_placeholder_grid">
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_home_panel">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Cobertura</span>
                                        <span>Puntos de venta</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_map">
                                        <div class="zrn_prodigyn_home_placeholder_blob"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_1"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_2"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_3"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_4"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_home_panel">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Indicadores</span>
                                        <span>Quick view</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_chart">
                                        <div class="zrn_prodigyn_home_placeholder_bars">
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_home_panel zrn_prodigyn_home_panel_wide">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Actividad reciente</span>
                                        <span>Ultimas acciones</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_list">
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="zrn_prodigyn_home_shell zrn_prodigyn_home_shell_secondary" invisible="page_key != 'workspace' or not show_dashboard">
                        <div class="zrn_prodigyn_home_hero zrn_prodigyn_home_hero_secondary">
                            <div class="zrn_prodigyn_home_hero_copy">
                                <div class="zrn_prodigyn_home_kicker">Workspace modular</div>
                                <div class="oe_title zrn_prodigyn_home">
                                    <h1>Exploracion del modulo</h1>
                                </div>
                                <div class="zrn_prodigyn_home_intro">
                                    Segunda pantalla para accesos rapidos, componentes futuros y zonas de analisis rapido del ecosistema Prodigyn.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_home_quickstats">
                                <div class="zrn_prodigyn_home_stat">
                                    <span class="zrn_prodigyn_home_stat_label">Procesos</span>
                                    <span class="zrn_prodigyn_home_stat_value">12</span>
                                </div>
                                <div class="zrn_prodigyn_home_stat">
                                    <span class="zrn_prodigyn_home_stat_label">Escenarios</span>
                                    <span class="zrn_prodigyn_home_stat_value">05</span>
                                </div>
                                <div class="zrn_prodigyn_home_stat">
                                    <span class="zrn_prodigyn_home_stat_label">Reportes</span>
                                    <span class="zrn_prodigyn_home_stat_value">09</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_home_dashboard zrn_prodigyn_home_dashboard_secondary">
                            <div class="zrn_prodigyn_home_modules">
                                <div class="zrn_prodigyn_home_section_title">Accesos genericos</div>
                                <div class="zrn_prodigyn_home_menu">
                                    <button name="action_open_summary" type="object" icon="fa-tachometer" string="Panel Ejecutivo" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"/>
                                    <button name="action_open_commercial_planning" type="object" icon="fa-clipboard" string="Pedidos y Demanda" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"/>
                                    <button name="action_open_production_planning" type="object" icon="fa-cogs" string="Produccion y Capacidad" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_secondary"/>
                                    <button name="action_open_supply_planning" type="object" icon="fa-cubes" string="Materiales e Insumos" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"/>
                                    <button name="action_open_logistics_planning" type="object" icon="fa-map-marker" string="Despachos y Rutas" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"/>
                                    <button name="action_open_resource_planning" type="object" icon="fa-id-badge" string="Personal y Turnos" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"/>
                                    <button name="action_open_scenarios" type="object" icon="fa-sliders" string="Escenarios de Simulacion" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_tertiary"/>
                                    <button name="action_open_reporting" type="object" icon="fa-area-chart" string="KPIs y Reportes" class="btn zrn_prodigyn_menu_btn zrn_prodigyn_menu_btn_primary"/>
                                </div>
                            </div>

                            <div class="zrn_prodigyn_home_previews">
                                <div class="zrn_prodigyn_home_panel">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Embudo operativo</span>
                                        <span>Resumen</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_chart">
                                        <div class="zrn_prodigyn_home_placeholder_bars">
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_home_panel">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Mapa de cobertura</span>
                                        <span>Vista rapida</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_map">
                                        <div class="zrn_prodigyn_home_placeholder_blob"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_1"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_2"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_3"/>
                                        <div class="zrn_prodigyn_home_placeholder_dot zrn_prodigyn_home_placeholder_dot_4"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_home_panel zrn_prodigyn_home_panel_wide">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Roadmap funcional</span>
                                        <span>Proximas piezas</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_list">
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                        <div class="zrn_prodigyn_home_placeholder_row"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_home_panel zrn_prodigyn_home_panel_wide">
                                    <div class="zrn_prodigyn_home_panel_head">
                                        <span>Componentes futuros</span>
                                        <span>Slots visuales</span>
                                    </div>
                                    <div class="zrn_prodigyn_home_panel_body zrn_prodigyn_home_placeholder_calendar">
                                        <div class="zrn_prodigyn_home_placeholder_grid">
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_inicio" model="ir.actions.act_window">
        <field name="name">Prodigyn</field>
        <field name="res_model">zrn_prodigyn.inicio</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_inicio_form"/>
        <field name="target">current</field>
        <field name="domain">[('page_key', 'in', ['overview', 'workspace'])]</field>
        <field name="context" eval="{'active_id': ref('zrn_prodigyn_inicio_default'), 'active_ids': [ref('zrn_prodigyn_inicio_default'), ref('zrn_prodigyn_inicio_secondary_default')]}"/>
    </record>

    <record id="action_zrn_prodigyn_support_url" model="ir.actions.act_url">
        <field name="name">Open Support</field>
        <field name="url">https://adm.zoraen.com/support?tkn=cualquier_cosa_por_ahora</field>
        <field name="target">new</field>
    </record>

    <record id="action_zrn_prodigyn_go_url" model="ir.actions.act_url">
        <field name="name">Prodigyn Go</field>
        <field name="url">https://prodigyn.zoraen.com/go?tkn=cualquier_cosa_por_ahora</field>
        <field name="target">new</field>
    </record>

    <record id="action_zrn_prodigyn_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'zrn_prodigyn'}</field>
    </record>

    <menuitem
        id="menu_zrn_prodigyn_root"
        name="Prodigyn"
        action="action_zrn_prodigyn_inicio"
        sequence="10"
        web_icon="zrn_prodigyn,static/zrn/imgs/prodigyn-l.png"
    />

