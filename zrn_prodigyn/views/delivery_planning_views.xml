<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_delivery_planning_default" model="zrn_prodigyn.delivery.planning">
        <field name="name">Planeacion de Entregas</field>
    </record>

    <record id="view_zrn_prodigyn_delivery_planning_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.delivery.planning.form</field>
        <field name="model">zrn_prodigyn.delivery.planning</field>
        <field name="arch" type="xml">
            <form string="Planeacion de Entregas" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_delivery_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Prodigyn"
                            class="btn zrn_prodigyn_back_btn"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>Planeacion de Entregas</h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_delivery_planning" model="ir.actions.act_window">
        <field name="name">Planeacion de Entregas</field>
        <field name="res_model">zrn_prodigyn.delivery.planning</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_delivery_planning_form"/>
        <field name="res_id" ref="zrn_prodigyn_delivery_planning_default"/>
        <field name="target">current</field>
    </record>

</odoo>
