<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_reporting_analysis_default" model="zrn_prodigyn.reporting.analysis">
        <field name="name">Reporteria y Analisis</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="zrn_prodigyn_reporting_analysis_workspace_default" model="zrn_prodigyn.reporting.analysis">
        <field name="name">Reporteria y Analisis</field>
        <field name="sequence">20</field>
        <field name="page_key">workspace</field>
    </record>

    <record id="view_zrn_prodigyn_reporting_analysis_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.reporting.analysis.form</field>
        <field name="model">zrn_prodigyn.reporting.analysis</field>
        <field name="arch" type="xml">
            <form string="Reporteria y Analisis" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_production_planning_form zrn_prodigyn_reporting_analysis_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button name="action_open_home" type="object" icon="fa-arrow-left" string="Volver a Prodigyn" class="btn zrn_prodigyn_back_btn"/>
                    </div>

                    <div class="zrn_prodigyn_production_shell" invisible="page_key != 'overview'">
                        <div class="zrn_prodigyn_production_hero">
                            <div class="zrn_prodigyn_production_hero_copy">
                                <div class="zrn_prodigyn_production_kicker">Analisis</div>
                                <div class="oe_title">
                                    <h1>Reporteria y Analisis</h1>
                                </div>
                                <div class="zrn_prodigyn_production_intro">
                                    Centro analitico para convertir los hubs HTML en vistas funcionales, escalables y separadas por tema dentro de Prodigyn.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_production_quickstats">
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Hubs</span>
                                    <span class="zrn_prodigyn_production_stat_value">08</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Vistas</span>
                                    <span class="zrn_prodigyn_production_stat_value">16</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Menus</span>
                                    <span class="zrn_prodigyn_production_stat_value">02</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_production_dashboard">
                            <div class="zrn_prodigyn_production_actions">
                                <div class="zrn_prodigyn_production_section_title">Hubs ejecutivos y funciones analiticas</div>
                                <div class="zrn_prodigyn_production_menu zrn_prodigyn_reporting_menu">
                                    <button name="action_open_reporting_executive" type="object" icon="fa-bullseye" string="Direccion Ejecutiva" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_reporting_commercial" type="object" icon="fa-line-chart" string="Hub Comercial" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_reporting_channels" type="object" icon="fa-sitemap" string="Canales y Cuentas" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_reporting_customers" type="object" icon="fa-users" string="Clientes y RFM" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_reporting_skus" type="object" icon="fa-tags" string="SKUs y Portafolio" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_reporting_financial" type="object" icon="fa-money" string="Hub Financiero" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_reporting_margin" type="object" icon="fa-percent" string="Margen y Rentabilidad" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_reporting_receivables" type="object" icon="fa-credit-card" string="Cartera y Cobros" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                </div>
                            </div>

                            <div class="zrn_prodigyn_production_panels">
                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Mapa de reportes</span>
                                        <span>Centros activos</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_grid">
                                        <div class="zrn_prodigyn_production_placeholder_cells">
                                            <div/><div/><div/><div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Lecturas clave</span>
                                        <span>Direccion</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_map">
                                        <div class="zrn_prodigyn_production_placeholder_blob"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_1"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_2"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_3"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Backlog de analitica</span>
                                        <span>Prioridades</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_chart">
                                        <div class="zrn_prodigyn_production_placeholder_bars">
                                            <div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Fuentes de referencia</span>
                                        <span>HTML examples</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_list">
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="zrn_prodigyn_production_shell zrn_prodigyn_production_shell_secondary" invisible="page_key != 'workspace'">
                        <div class="zrn_prodigyn_production_hero zrn_prodigyn_production_hero_secondary">
                            <div class="zrn_prodigyn_production_hero_copy">
                                <div class="zrn_prodigyn_production_kicker">Workspaces especializados</div>
                                <div class="oe_title">
                                    <h1>Exploracion operativa y performance</h1>
                                </div>
                                <div class="zrn_prodigyn_production_intro">
                                    Segundo menu para abrir funciones analiticas operativas, cobertura, media y escenarios como piezas independientes del ecosistema.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_production_quickstats">
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Cobertura</span>
                                    <span class="zrn_prodigyn_production_stat_value">02</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Operaciones</span>
                                    <span class="zrn_prodigyn_production_stat_value">03</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Media</span>
                                    <span class="zrn_prodigyn_production_stat_value">03</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_production_dashboard">
                            <div class="zrn_prodigyn_production_actions">
                                <div class="zrn_prodigyn_production_section_title">Accesos de analisis operativo</div>
                                <div class="zrn_prodigyn_production_menu zrn_prodigyn_reporting_menu zrn_prodigyn_reporting_menu_workspace">
                                    <button name="action_open_reporting_operations" type="object" icon="fa-cogs" string="Hub Operaciones" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_reporting_forecast" type="object" icon="fa-line-chart" string="Forecast de Demanda" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_reporting_stockouts" type="object" icon="fa-exclamation-triangle" string="Stockouts y Alertas" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_reporting_coverage" type="object" icon="fa-map-marker" string="PDV y Cobertura" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_reporting_velocity" type="object" icon="fa-tachometer" string="Velocity por PDV" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_reporting_rrhh" type="object" icon="fa-users" string="Hub RRHH" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_reporting_media" type="object" icon="fa-play-circle" string="Media Report" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_reporting_scenarios" type="object" icon="fa-sliders" string="Escenarios" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                </div>
                            </div>

                            <div class="zrn_prodigyn_production_panels">
                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Cobertura</span>
                                        <span>Mapa</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_chart">
                                        <div class="zrn_prodigyn_production_placeholder_bars">
                                            <div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Talento</span>
                                        <span>RRHH</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_list">
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Media y performance</span>
                                        <span>Paid y organic</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_grid">
                                        <div class="zrn_prodigyn_production_placeholder_cells">
                                            <div/><div/><div/><div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Escenarios y planeacion</span>
                                        <span>What-if</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_list">
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_reporting_analysis" model="ir.actions.act_window">
        <field name="name">Reporteria y Analisis</field>
        <field name="res_model">zrn_prodigyn.reporting.analysis</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_reporting_analysis_form"/>
        <field name="res_id" ref="zrn_prodigyn_reporting_analysis_default"/>
        <field name="target">current</field>
        <field name="domain">[('page_key', 'in', ['overview', 'workspace'])]</field>
        <field name="context" eval="{'active_id': ref('zrn_prodigyn_reporting_analysis_default'), 'active_ids': [ref('zrn_prodigyn_reporting_analysis_default'), ref('zrn_prodigyn_reporting_analysis_workspace_default')]}"/>
    </record>

    <record id="action_zrn_prodigyn_reporting_analysis_workspace" model="ir.actions.act_window">
        <field name="name">Reporteria y Analisis</field>
        <field name="res_model">zrn_prodigyn.reporting.analysis</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_reporting_analysis_form"/>
        <field name="res_id" ref="zrn_prodigyn_reporting_analysis_workspace_default"/>
        <field name="target">current</field>
        <field name="domain">[('page_key', 'in', ['overview', 'workspace'])]</field>
        <field name="context" eval="{'active_id': ref('zrn_prodigyn_reporting_analysis_workspace_default'), 'active_ids': [ref('zrn_prodigyn_reporting_analysis_default'), ref('zrn_prodigyn_reporting_analysis_workspace_default')]}"/>
    </record>

</odoo>
