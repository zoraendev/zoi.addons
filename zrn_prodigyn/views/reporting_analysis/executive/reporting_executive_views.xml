<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_reporting_executive_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Direccion Ejecutiva</field>
    </record>

    <record id="view_zrn_prodigyn_reporting_executive_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.reporting.executive.form</field>
        <field name="model">zrn_prodigyn.internal.tool</field>
        <field name="arch" type="xml">
            <form string="Direccion Ejecutiva" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_internal_tool_form zrn_prodigyn_reporting_executive_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button
                            name="action_open_reporting_center"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Reporteria y Analisis"
                            class="btn zrn_prodigyn_back_btn"
                        />
                    </div>

                    <div
                        class="zrn_prodigyn_reporting_executive_view"
                        data-executive-dashboard="1"
                        data-example-source="examples/COOKOO_HUB_Direccion.html"
                    >
                        <div class="zrn_prodigyn_reporting_executive_hero">
                            <div class="zrn_prodigyn_reporting_executive_hero_copy">
                                <div class="zrn_prodigyn_reporting_executive_kicker">Direccion</div>
                                <div class="oe_title">
                                    <h1>Direccion Ejecutiva</h1>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_intro">
                                    Vista base para consolidar indicadores, alertas y seguimiento ejecutivo tomando como referencia el hub funcional.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_reporting_executive_status">
                                <span class="zrn_prodigyn_reporting_executive_status_label">Referencia</span>
                                <span class="zrn_prodigyn_reporting_executive_status_value">Hub de direccion</span>
                                <span class="zrn_prodigyn_reporting_executive_status_meta">Fuente: COOKOO_HUB_Direccion</span>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_reporting_executive_stage">
                            <div class="zrn_prodigyn_reporting_executive_stage_head">
                                <span>Estructura inicial</span>
                                <span>Bloques listos para datos reales</span>
                            </div>
                            <div class="zrn_prodigyn_reporting_executive_stage_body">
                                <div class="zrn_prodigyn_reporting_executive_stage_item">
                                    <strong>1. Resumen ejecutivo</strong>
                                    <span>Hero, periodo, corte y KPIs de cabecera.</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_stage_item">
                                    <strong>2. Salud por centro</strong>
                                    <span>Tarjetas para Comercial, Finanzas, Operaciones y Cobertura.</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_stage_item">
                                    <strong>3. Alertas y hitos</strong>
                                    <span>Backlog transversal y agenda de decisiones.</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_reporting_executive_grid">
                            <section class="zrn_prodigyn_reporting_executive_panel zrn_prodigyn_reporting_executive_panel_wide">
                                <div class="zrn_prodigyn_reporting_executive_panel_head">
                                    <span>KPIs de cabecera</span>
                                    <span>Montados desde JS</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_kpis" data-executive-kpis="1"/>
                            </section>

                            <section class="zrn_prodigyn_reporting_executive_panel zrn_prodigyn_reporting_executive_panel_wide">
                                <div class="zrn_prodigyn_reporting_executive_panel_head">
                                    <span>Centros y semaforos</span>
                                    <span>Lectura rapida para direccion</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_centers" data-executive-centers="1"/>
                            </section>

                            <section class="zrn_prodigyn_reporting_executive_panel">
                                <div class="zrn_prodigyn_reporting_executive_panel_head">
                                    <span>Alertas cruzadas</span>
                                    <span>Seguimiento inmediato</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_alerts" data-executive-alerts="1"/>
                            </section>

                            <section class="zrn_prodigyn_reporting_executive_panel">
                                <div class="zrn_prodigyn_reporting_executive_panel_head">
                                    <span>Agenda ejecutiva</span>
                                    <span>Hitos y decisiones</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_executive_timeline" data-executive-timeline="1"/>
                            </section>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_reporting_executive" model="ir.actions.act_window">
        <field name="name">Direccion Ejecutiva</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_reporting_executive_form"/>
        <field name="res_id" ref="zrn_prodigyn_reporting_executive_default"/>
        <field name="target">current</field>
    </record>

</odoo>
