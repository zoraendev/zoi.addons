<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_reporting_coverage_default" model="zrn_prodigyn.internal.tool">
        <field name="name">PDV y Cobertura</field>
    </record>

    <record id="view_zrn_prodigyn_reporting_coverage_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.reporting.coverage.form</field>
        <field name="model">zrn_prodigyn.internal.tool</field>
        <field name="arch" type="xml">
            <form string="PDV y Cobertura" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_internal_tool_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button name="action_open_reporting_center" type="object" icon="fa-arrow-left" string="Volver a Reporteria y Analisis" class="btn zrn_prodigyn_back_btn"/>
                    </div>
                    <div class="oe_title">
                        <h1>PDV y Cobertura</h1>
                    </div>
                    <div class="zrn_prodigyn_building_state">
                        <div class="zrn_prodigyn_building_loader" aria-hidden="true">
                            <span class="zrn_prodigyn_building_loader_ring zrn_prodigyn_building_loader_ring_outer"/>
                            <span class="zrn_prodigyn_building_loader_ring zrn_prodigyn_building_loader_ring_inner"/>
                            <span class="zrn_prodigyn_building_loader_core"/>
                        </div>
                        <div class="zrn_prodigyn_building_copy">
                            <div class="zrn_prodigyn_building_kicker">Trabajando</div>
                            <div class="zrn_prodigyn_building_title">Estamos preparando esta vista</div>
                            <div class="zrn_prodigyn_building_messages" aria-live="polite">
                                <span>Separando el mapa de PDVs y cobertura...</span>
                                <span>Dejando listo el espacio para velocity por punto...</span>
                                <span>Reservando la tabla de cobertura y expansion...</span>
                                <span>Montando esta vista para construirla despues...</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_reporting_coverage" model="ir.actions.act_window">
        <field name="name">PDV y Cobertura</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_reporting_coverage_form"/>
        <field name="res_id" ref="zrn_prodigyn_reporting_coverage_default"/>
        <field name="target">current</field>
    </record>

</odoo>
