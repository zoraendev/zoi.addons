<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_reporting_commercial_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Hub Comercial</field>
    </record>

    <record id="view_zrn_prodigyn_reporting_commercial_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.reporting.commercial.form</field>
        <field name="model">zrn_prodigyn.internal.tool</field>
        <field name="arch" type="xml">
            <form string="Hub Comercial" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_internal_tool_form zrn_prodigyn_reporting_commercial_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>

                    <div class="zrn_prodigyn_submodule_nav">
                        <button
                            name="action_open_reporting_center"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Reporteria y Analisis"
                            class="btn zrn_prodigyn_back_btn"
                        />
                    </div>

                    <div class="zrn_prodigyn_reporting_commercial_view">
                        <div class="zrn_prodigyn_reporting_commercial_stats">
                            <div class="zrn_prodigyn_reporting_commercial_stat_box">
                                <span>Venta total</span>
                                <strong><field name="commercial_total_amount" readonly="1" nolabel="1" widget="monetary" options="{'currency_field': 'company_currency_id'}"/></strong>
                            </div>
                            <div class="zrn_prodigyn_reporting_commercial_stat_box">
                                <span>Pedidos</span>
                                <strong><field name="commercial_order_count" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_reporting_commercial_stat_box">
                                <span>Cuentas comerciales</span>
                                <strong><field name="commercial_customer_count" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_reporting_commercial_stat_box">
                                <span>PDVs</span>
                                <strong><field name="commercial_point_count" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="zrn_prodigyn_reporting_commercial_stat_box">
                                <span>Productos</span>
                                <strong><field name="commercial_product_count" readonly="1" nolabel="1"/></strong>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_reporting_commercial_grid">
                            <section class="zrn_prodigyn_reporting_commercial_panel zrn_prodigyn_reporting_commercial_panel_wide">
                                <div class="zrn_prodigyn_reporting_commercial_panel_head">
                                    <div class="zrn_prodigyn_reporting_commercial_chart_tabs" data-commercial-chart-tabs="1">
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab is-active" data-chart-tab="linea">Venta diaria, pedidos diarios, unidades</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="barras_verticales">Venta total, pedidos, unidades</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="barras_horizontales">Top clientes, top PDVs, top productos</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="barras_apiladas">Venta por canal y producto</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="pareto">Clientes, PDVs, productos</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="heatmap">Venta diaria, pedidos, actividad</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="donut">Venta por canal o categoria</a>
                                        <a href="#" class="zrn_prodigyn_reporting_commercial_chart_tab" data-chart-tab="scatter">Ticket promedio vs pedidos vs venta</a>
                                    </div>
                                    <span>Graficas utiles del resumen</span>
                                </div>
                                <div class="zrn_prodigyn_reporting_commercial_daily_static">
                                    <div class="zrn_prodigyn_reporting_commercial_chart_stage">
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel is-active" data-chart-panel="linea">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Venta diaria, pedidos diarios, unidades</strong>
                                                <span>Grafica nativa de Odoo con la venta diaria de los ultimos 14 dias.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_native">
                                                <field name="commercial_daily_graph_data" widget="dashboard_graph" graph_type="line" readonly="1" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="barras_verticales">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Venta total, pedidos, unidades</strong>
                                                <span>Grafica nativa de Odoo con la venta total agrupada por semana.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_native">
                                                <field name="commercial_totals_graph_data" widget="dashboard_graph" graph_type="bar" readonly="1" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="barras_horizontales">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Top clientes, top PDVs, top productos</strong>
                                                <span>Grafica nativa de Odoo con ranking actual de productos por venta.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_native">
                                                <field name="commercial_ranking_graph_data" widget="dashboard_graph" graph_type="bar" readonly="1" nolabel="1"/>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="barras_apiladas">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Venta por canal y producto</strong>
                                                <span>Queda como referencia visual mientras definimos la composicion real por canal y producto.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_placeholder zrn_prodigyn_reporting_commercial_chart_placeholder_stacked" aria-hidden="true">
                                                <div><i style="height:34%"></i><i style="height:18%"></i><i style="height:12%"></i></div>
                                                <div><i style="height:42%"></i><i style="height:16%"></i><i style="height:9%"></i></div>
                                                <div><i style="height:28%"></i><i style="height:22%"></i><i style="height:14%"></i></div>
                                                <div><i style="height:48%"></i><i style="height:20%"></i><i style="height:10%"></i></div>
                                                <div><i style="height:36%"></i><i style="height:18%"></i><i style="height:16%"></i></div>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="pareto">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Clientes, PDVs, productos</strong>
                                                <span>Queda estatico por ahora hasta separar el acumulado 80/20 sobre clientes, PDVs y productos.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_placeholder zrn_prodigyn_reporting_commercial_chart_placeholder_pareto" aria-hidden="true">
                                                <div class="zrn_prodigyn_reporting_commercial_chart_placeholder_bars">
                                                    <span style="height:78%"></span>
                                                    <span style="height:56%"></span>
                                                    <span style="height:42%"></span>
                                                    <span style="height:34%"></span>
                                                    <span style="height:28%"></span>
                                                    <span style="height:20%"></span>
                                                </div>
                                                <div class="zrn_prodigyn_reporting_commercial_chart_placeholder_curve">
                                                    <span style="left:5%; top:68%"></span>
                                                    <span style="left:23%; top:46%"></span>
                                                    <span style="left:41%; top:30%"></span>
                                                    <span style="left:59%; top:18%"></span>
                                                    <span style="left:77%; top:11%"></span>
                                                    <span style="left:92%; top:8%"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="heatmap">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Venta diaria, pedidos, actividad</strong>
                                                <span>Queda estatico por ahora hasta construir la matriz diaria de actividad comercial.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_placeholder zrn_prodigyn_reporting_commercial_chart_placeholder_heatmap" aria-hidden="true">
                                                <span class="tone-1"></span><span class="tone-3"></span><span class="tone-2"></span><span class="tone-4"></span><span class="tone-1"></span><span class="tone-5"></span><span class="tone-2"></span>
                                                <span class="tone-2"></span><span class="tone-4"></span><span class="tone-1"></span><span class="tone-3"></span><span class="tone-2"></span><span class="tone-4"></span><span class="tone-1"></span>
                                                <span class="tone-3"></span><span class="tone-1"></span><span class="tone-2"></span><span class="tone-5"></span><span class="tone-3"></span><span class="tone-2"></span><span class="tone-4"></span>
                                                <span class="tone-1"></span><span class="tone-2"></span><span class="tone-4"></span><span class="tone-2"></span><span class="tone-5"></span><span class="tone-3"></span><span class="tone-1"></span>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="donut">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Venta por canal o categoria</strong>
                                                <span>Queda estatico por ahora mientras definimos la participacion real por canal o categoria.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_placeholder zrn_prodigyn_reporting_commercial_chart_placeholder_donut" aria-hidden="true">
                                                <div class="zrn_prodigyn_reporting_commercial_donut_ring"></div>
                                                <div class="zrn_prodigyn_reporting_commercial_donut_legend">
                                                    <span></span><span></span><span></span><span></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="zrn_prodigyn_reporting_commercial_chart_panel" data-chart-panel="scatter">
                                            <div class="zrn_prodigyn_reporting_commercial_chart_meta">
                                                <strong>Ticket promedio vs pedidos vs venta</strong>
                                                <span>Queda estatico por ahora hasta modelar la relacion entre ticket, pedidos y venta.</span>
                                            </div>
                                            <div class="zrn_prodigyn_reporting_commercial_chart_placeholder zrn_prodigyn_reporting_commercial_chart_placeholder_scatter" aria-hidden="true">
                                                <span style="left:10%; top:70%; width:18px; height:18px"></span>
                                                <span style="left:24%; top:52%; width:22px; height:22px"></span>
                                                <span style="left:38%; top:60%; width:14px; height:14px"></span>
                                                <span style="left:52%; top:34%; width:28px; height:28px"></span>
                                                <span style="left:66%; top:44%; width:20px; height:20px"></span>
                                                <span style="left:80%; top:26%; width:32px; height:32px"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="zrn_prodigyn_reporting_commercial_panel">
                                <div class="zrn_prodigyn_reporting_commercial_panel_head">
                                    <span>Top canales / cuentas</span>
                                    <span>Tabla nativa Odoo</span>
                                </div>
                                <field name="commercial_channel_line_ids" readonly="1" nolabel="1">
                                    <tree create="0" edit="0" delete="0">
                                        <field name="partner_id"/>
                                        <field name="order_count"/>
                                        <field name="unit_count" sum="Total unidades"/>
                                        <field name="average_ticket" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Venta total"/>
                                        <field name="last_order_date"/>
                                    </tree>
                                </field>
                            </section>

                            <section class="zrn_prodigyn_reporting_commercial_panel">
                                <div class="zrn_prodigyn_reporting_commercial_panel_head">
                                    <span>Top clientes / PDVs</span>
                                    <span>Tabla nativa Odoo</span>
                                </div>
                                <field name="commercial_customer_line_ids" readonly="1" nolabel="1">
                                    <tree create="0" edit="0" delete="0">
                                        <field name="partner_id"/>
                                        <field name="customer_id"/>
                                        <field name="order_count"/>
                                        <field name="unit_count" sum="Total unidades"/>
                                        <field name="average_ticket" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Venta total"/>
                                        <field name="last_order_date"/>
                                    </tree>
                                </field>
                            </section>

                            <section class="zrn_prodigyn_reporting_commercial_panel zrn_prodigyn_reporting_commercial_panel_wide">
                                <div class="zrn_prodigyn_reporting_commercial_panel_head">
                                    <span>Top productos</span>
                                    <span>Tabla nativa Odoo</span>
                                </div>
                                <field name="commercial_product_line_ids" readonly="1" nolabel="1">
                                    <tree create="0" edit="0" delete="0">
                                        <field name="product_id"/>
                                        <field name="default_code"/>
                                        <field name="category_name"/>
                                        <field name="customer_count"/>
                                        <field name="order_count"/>
                                        <field name="quantity_sold" sum="Total unidades"/>
                                        <field name="sales_amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Venta total"/>
                                    </tree>
                                </field>
                            </section>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_reporting_commercial" model="ir.actions.act_window">
        <field name="name">Hub Comercial</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_reporting_commercial_form"/>
        <field name="res_id" ref="zrn_prodigyn_reporting_commercial_default"/>
        <field name="target">current</field>
    </record>

</odoo>
