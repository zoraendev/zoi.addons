<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_summary_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Resumen General</field>
    </record>

    <record id="zrn_prodigyn_resource_planning_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Planeacion de Recursos</field>
    </record>

    <record id="zrn_prodigyn_scenarios_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Escenarios y Simulaciones</field>
    </record>

    <record id="zrn_prodigyn_reporting_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Reporteria y Analisis</field>
    </record>

    <record id="view_zrn_prodigyn_internal_tool_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.internal.tool.form</field>
        <field name="model">zrn_prodigyn.internal.tool</field>
        <field name="arch" type="xml">
            <form string="Prodigyn" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_internal_tool_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_prodigyn_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Prodigyn"
                            class="btn zrn_prodigyn_back_btn"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" nolabel="1" class="oe_inline"/>
                        </h1>
                    </div>
                    <div class="zrn_prodigyn_building_state">
                        <div class="zrn_prodigyn_building_loader" aria-hidden="true">
                            <span class="zrn_prodigyn_building_loader_ring zrn_prodigyn_building_loader_ring_outer"/>
                            <span class="zrn_prodigyn_building_loader_ring zrn_prodigyn_building_loader_ring_inner"/>
                            <span class="zrn_prodigyn_building_loader_core"/>
                        </div>
                        <div class="zrn_prodigyn_building_copy">
                            <div class="zrn_prodigyn_building_kicker">Vista en construccion</div>
                            <div class="zrn_prodigyn_building_title">Estamos armando este modulo</div>
                            <div class="zrn_prodigyn_building_messages" aria-live="polite">
                                <span>Construyendo componentes y accesos rapidos...</span>
                                <span>Preparando widgets, datos y visualizaciones...</span>
                                <span>Organizando la capa operativa de Prodigyn...</span>
                                <span>Dejando lista la siguiente iteracion de esta vista...</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_summary" model="ir.actions.act_window">
        <field name="name">Resumen General</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_internal_tool_form"/>
        <field name="res_id" ref="zrn_prodigyn_summary_default"/>
        <field name="target">current</field>
    </record>

    <record id="action_zrn_prodigyn_resource_planning" model="ir.actions.act_window">
        <field name="name">Planeacion de Recursos</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_internal_tool_form"/>
        <field name="res_id" ref="zrn_prodigyn_resource_planning_default"/>
        <field name="target">current</field>
    </record>

    <record id="action_zrn_prodigyn_scenarios" model="ir.actions.act_window">
        <field name="name">Escenarios y Simulaciones</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_internal_tool_form"/>
        <field name="res_id" ref="zrn_prodigyn_scenarios_default"/>
        <field name="target">current</field>
    </record>

    <record id="action_zrn_prodigyn_reporting" model="ir.actions.act_window">
        <field name="name">Reporteria y Analisis</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_internal_tool_form"/>
        <field name="res_id" ref="zrn_prodigyn_reporting_default"/>
        <field name="target">current</field>
    </record>

</odoo>
