<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_commercial_brands_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Marcas comerciales</field>
    </record>

    <record id="zrn_prodigyn_commercial_portfolio_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Portafolio comercial</field>
    </record>

    <record id="zrn_prodigyn_commercial_customers_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Clientes y cuentas</field>
    </record>

    <record id="zrn_prodigyn_commercial_channels_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Canales comerciales</field>
    </record>

    <record id="zrn_prodigyn_commercial_campaigns_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Campanas comerciales</field>
    </record>

    <record id="zrn_prodigyn_commercial_pricing_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Pricing comercial</field>
    </record>

    <record id="zrn_prodigyn_commercial_targets_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Metas y seguimiento</field>
    </record>

    <record id="zrn_prodigyn_commercial_calendar_default" model="zrn_prodigyn.internal.tool">
        <field name="name">Calendario comercial</field>
    </record>

    <record id="view_zrn_prodigyn_commercial_placeholder_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.commercial.placeholder.form</field>
        <field name="model">zrn_prodigyn.internal.tool</field>
        <field name="arch" type="xml">
            <form string="Planeacion Comercial" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_internal_tool_form zrn_prodigyn_commercial_placeholder_form">
                <sheet>
                    <field name="name" invisible="1"/>

                    <div class="zrn_prodigyn_submodule_nav">
                        <button name="action_open_commercial_center" type="object" icon="fa-arrow-left" string="Volver a Planeacion Comercial" class="btn zrn_prodigyn_back_btn"/>
                    </div>

                    <div class="zrn_prodigyn_production_shell">
                        <div class="zrn_prodigyn_production_hero">
                            <div class="zrn_prodigyn_production_hero_copy">
                                <div class="zrn_prodigyn_production_kicker">Planeacion Comercial</div>
                                <div class="oe_title">
                                    <h1><field name="name" readonly="1" nolabel="1" class="oe_inline"/></h1>
                                </div>
                                <div class="zrn_prodigyn_production_intro">
                                    Vista base para reservar este frente comercial y dejar listo el espacio donde luego vivira la logica funcional.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_production_quickstats">
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Estado</span>
                                    <span class="zrn_prodigyn_production_stat_value">Base</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Diseno</span>
                                    <span class="zrn_prodigyn_production_stat_value">HTML</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Siguiente paso</span>
                                    <span class="zrn_prodigyn_production_stat_value">Logica</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_production_dashboard">
                            <div class="zrn_prodigyn_production_panels">
                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Espacio principal</span>
                                        <span>Reservado para desarrollo</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_grid">
                                        <div class="zrn_prodigyn_production_placeholder_cells">
                                            <div/><div/><div/><div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Bloque lateral</span>
                                        <span>Referencia</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_list">
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Visual rapido</span>
                                        <span>Placeholder</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_chart">
                                        <div class="zrn_prodigyn_production_placeholder_bars">
                                            <div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_commercial_brands" model="ir.actions.act_window">
        <field name="name">Marcas comerciales</field>
        <field name="res_model">zrn_prodigyn.internal.tool</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_commercial_placeholder_form"/>
        <field name="res_id" ref="zrn_prodigyn_commercial_brands_default"/>
        <field name="target">current</field>
    </record>

