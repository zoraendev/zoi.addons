<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_prodigyn_commercial_brand_list" model="ir.ui.view">
        <field name="name">zrn_prodigyn.commercial.brand.list</field>
        <field name="model">zrn_prodigyn.commercial.brand</field>
        <field name="arch" type="xml">
            <tree string="Marcas comerciales">
                <field name="active" optional="show" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="owner_name" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="product_count" string="Productos"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_prodigyn_commercial_brand_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.commercial.brand.form</field>
        <field name="model">zrn_prodigyn.commercial.brand</field>
        <field name="arch" type="xml">
            <form string="Marca comercial">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la marca"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="owner_name" placeholder="Empresa o grupo titular de la marca"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                            <field name="country_id"/>
                            <field name="launch_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="website"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <group>
                                <field name="description" placeholder="Descripcion de la marca"/>
                                <field name="notes" placeholder="Notas internas"/>
                            </group>
                        </page>
                        <page string="Productos">
                            <field name="product_link_ids" context="{'default_brand_id': id}">
                                <tree editable="bottom" string="Productos asociados">
                                    <field name="available_product_ids" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="default_code" readonly="1"/>
                                    <field name="categ_id" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="active" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                                <form string="Producto asociado">
                                    <group>
                                        <field name="available_product_ids" invisible="1"/>
                                        <field name="product_id"/>
                                        <field name="default_code" readonly="1"/>
                                        <field name="categ_id" readonly="1"/>
                                        <field name="uom_id" readonly="1"/>
                                        <field name="active"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_commercial_brands" model="ir.actions.act_window">
        <field name="name">Marcas comerciales</field>
        <field name="res_model">zrn_prodigyn.commercial.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_zrn_prodigyn_commercial_brand_list"/>
        <field name="res_id" eval="False"/>
        <field name="context">{}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera marca comercial
            </p>
            <p>
                Aqui podras registrar las marcas comerciales para luego agrupar productos y construir metricas de inventario, ventas y compras.
            </p>
        </field>
    </record>

</odoo>
