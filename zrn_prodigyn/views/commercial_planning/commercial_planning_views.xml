<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_prodigyn_commercial_planning_center_default" model="zrn_prodigyn.commercial.planning">
        <field name="name">Planeacion Comercial</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="zrn_prodigyn_commercial_planning_center_workspace_default" model="zrn_prodigyn.commercial.planning">
        <field name="name">Planeacion Comercial</field>
        <field name="sequence">20</field>
        <field name="page_key">workspace</field>
    </record>

    <record id="view_zrn_prodigyn_commercial_planning_form" model="ir.ui.view">
        <field name="name">zrn_prodigyn.commercial.planning.form</field>
        <field name="model">zrn_prodigyn.commercial.planning</field>
        <field name="arch" type="xml">
            <form string="Planeacion Comercial" js_class="zrn_prodigyn_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_prodigyn_submodule_form zrn_prodigyn_production_planning_form zrn_prodigyn_commercial_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>

                    <div class="zrn_prodigyn_submodule_nav">
                        <button name="action_open_home" type="object" icon="fa-arrow-left" string="Volver a Prodigyn" class="btn zrn_prodigyn_back_btn"/>
                    </div>

                    <div class="zrn_prodigyn_production_shell" invisible="page_key != 'overview'">
                        <div class="zrn_prodigyn_production_hero">
                            <div class="zrn_prodigyn_production_hero_copy">
                                <div class="zrn_prodigyn_production_kicker">Comercial</div>
                                <div class="oe_title">
                                    <h1>Planeacion Comercial</h1>
                                </div>
                                <div class="zrn_prodigyn_production_intro">
                                    Centro base para ordenar marcas, portafolio, clientes y frentes comerciales desde una estructura compacta lista para crecer.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_production_quickstats">
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Menus</span>
                                    <span class="zrn_prodigyn_production_stat_value">02</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Frentes</span>
                                    <span class="zrn_prodigyn_production_stat_value">08</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Base inicial</span>
                                    <span class="zrn_prodigyn_production_stat_value">OK</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_production_dashboard">
                            <div class="zrn_prodigyn_production_actions">
                                <div class="zrn_prodigyn_production_section_title">Estructura principal comercial</div>
                                <div class="zrn_prodigyn_production_menu zrn_prodigyn_reporting_menu">
                                    <button name="action_open_commercial_brands" type="object" icon="fa-tags" string="Marcas" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_commercial_portfolio" type="object" icon="fa-archive" string="Portafolio" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_commercial_customers" type="object" icon="fa-users" string="Clientes" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_commercial_channels" type="object" icon="fa-sitemap" string="Canales" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_commercial_calendar" type="object" icon="fa-calendar" string="Calendario comercial" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_commercial_targets" type="object" icon="fa-bullseye" string="Metas y cuotas" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_commercial_campaigns" type="object" icon="fa-bullhorn" string="Campanas" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_commercial_workspace" type="object" icon="fa-columns" string="Vista de trabajo" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                </div>
                            </div>

                            <div class="zrn_prodigyn_production_panels">
                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Ruta comercial</span>
                                        <span>Espacio reservado</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_grid">
                                        <div class="zrn_prodigyn_production_placeholder_cells">
                                            <div/><div/><div/><div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Mapa de frentes</span>
                                        <span>Marcas y canales</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_map">
                                        <div class="zrn_prodigyn_production_placeholder_blob"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_1"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_2"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_3"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Prioridades</span>
                                        <span>Siguiente fase</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_chart">
                                        <div class="zrn_prodigyn_production_placeholder_bars">
                                            <div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Espacios listos para poblar</span>
                                        <span>Backlog comercial</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_list">
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="zrn_prodigyn_production_shell zrn_prodigyn_production_shell_secondary" invisible="page_key != 'workspace'">
                        <div class="zrn_prodigyn_production_hero zrn_prodigyn_production_hero_secondary">
                            <div class="zrn_prodigyn_production_hero_copy">
                                <div class="zrn_prodigyn_production_kicker">Workspace comercial</div>
                                <div class="oe_title">
                                    <h1>Vista operativa comercial</h1>
                                </div>
                                <div class="zrn_prodigyn_production_intro">
                                    Segunda pagina para ordenar tareas futuras de pricing, promociones, mix y seguimiento sin salir del modulo.
                                </div>
                            </div>
                            <div class="zrn_prodigyn_production_quickstats">
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Pricing</span>
                                    <span class="zrn_prodigyn_production_stat_value">01</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Promos</span>
                                    <span class="zrn_prodigyn_production_stat_value">01</span>
                                </div>
                                <div class="zrn_prodigyn_production_stat">
                                    <span class="zrn_prodigyn_production_stat_label">Seguimiento</span>
                                    <span class="zrn_prodigyn_production_stat_value">04</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_prodigyn_production_dashboard">
                            <div class="zrn_prodigyn_production_actions">
                                <div class="zrn_prodigyn_production_section_title">Accesos de trabajo comercial</div>
                                <div class="zrn_prodigyn_production_menu zrn_prodigyn_reporting_menu zrn_prodigyn_reporting_menu_workspace">
                                    <button name="action_open_commercial_overview" type="object" icon="fa-home" string="Centro comercial" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_commercial_brands" type="object" icon="fa-tags" string="Marcas comerciales" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_commercial_pricing" type="object" icon="fa-usd" string="Pricing" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_commercial_campaigns" type="object" icon="fa-bullhorn" string="Promociones" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_commercial_channels" type="object" icon="fa-share-alt" string="Rutas por canal" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_secondary"/>
                                    <button name="action_open_commercial_customers" type="object" icon="fa-address-book" string="Cuentas clave" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                    <button name="action_open_commercial_portfolio" type="object" icon="fa-cubes" string="Mix y referencias" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_tertiary"/>
                                    <button name="action_open_commercial_targets" type="object" icon="fa-flag-checkered" string="Seguimiento" class="btn zrn_prodigyn_submodule_menu_btn zrn_prodigyn_reporting_menu_btn zrn_prodigyn_submodule_menu_btn_primary"/>
                                </div>
                            </div>

                            <div class="zrn_prodigyn_production_panels">
                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Pricing</span>
                                        <span>Base</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_chart">
                                        <div class="zrn_prodigyn_production_placeholder_bars">
                                            <div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Campanas</span>
                                        <span>Agenda</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_list">
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                        <div class="zrn_prodigyn_production_placeholder_row"/>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Mix comercial</span>
                                        <span>Portafolio y marcas</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_grid">
                                        <div class="zrn_prodigyn_production_placeholder_cells">
                                            <div/><div/><div/><div/><div/><div/><div/><div/>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_prodigyn_production_panel zrn_prodigyn_production_panel_wide">
                                    <div class="zrn_prodigyn_production_panel_head">
                                        <span>Seguimiento comercial</span>
                                        <span>Espacio reservado</span>
                                    </div>
                                    <div class="zrn_prodigyn_production_panel_body zrn_prodigyn_production_placeholder_map">
                                        <div class="zrn_prodigyn_production_placeholder_blob"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_1"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_2"/>
                                        <div class="zrn_prodigyn_production_placeholder_dot zrn_prodigyn_production_placeholder_dot_3"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_prodigyn_commercial_planning" model="ir.actions.act_window">
        <field name="name">Planeacion Comercial</field>
        <field name="res_model">zrn_prodigyn.commercial.planning</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_commercial_planning_form"/>
        <field name="res_id" ref="zrn_prodigyn_commercial_planning_center_default"/>
        <field name="target">current</field>
        <field name="domain">[('page_key', 'in', ['overview', 'workspace'])]</field>
        <field name="context" eval="{'active_id': ref('zrn_prodigyn_commercial_planning_center_default'), 'active_ids': [ref('zrn_prodigyn_commercial_planning_center_default'), ref('zrn_prodigyn_commercial_planning_center_workspace_default')]}"/>
    </record>

    <record id="action_zrn_prodigyn_commercial_planning_workspace" model="ir.actions.act_window">
        <field name="name">Planeacion Comercial</field>
        <field name="res_model">zrn_prodigyn.commercial.planning</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_prodigyn_commercial_planning_form"/>
        <field name="res_id" ref="zrn_prodigyn_commercial_planning_center_workspace_default"/>
        <field name="target">current</field>
        <field name="domain">[('page_key', 'in', ['overview', 'workspace'])]</field>
        <field name="context" eval="{'active_id': ref('zrn_prodigyn_commercial_planning_center_workspace_default'), 'active_ids': [ref('zrn_prodigyn_commercial_planning_center_default'), ref('zrn_prodigyn_commercial_planning_center_workspace_default')]}"/>
    </record>

</odoo>
