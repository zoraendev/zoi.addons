<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_analitics.HubPdvFilters">
        <section class="zrn_analitics_hub_panel">
            <div class="zrn_analitics_pdv_panel_head">
                <span>Filtros PDV</span>
                <span>Segmenta el centro PDV por periodo, canal, marca y categoria</span>
            </div>
            <div class="zrn_analitics_pdv_filters">
                <div class="zrn_analitics_pdv_field">
                    <label>Desde</label>
                    <input type="date" class="form-control" t-att-value="state.pdvFilters.date_from" t-on-input="(ev) => this.onPdvDateFromInput(ev)"/>
                </div>
                <div class="zrn_analitics_pdv_field">
                    <label>Hasta</label>
                    <input type="date" class="form-control" t-att-value="state.pdvFilters.date_to" t-on-input="(ev) => this.onPdvDateToInput(ev)"/>
                </div>
                <div class="zrn_analitics_pdv_field">
                    <label>Marca</label>
                    <ZrnRelationalMultiSelect
                        records="getSelectedOptionRecords(pdvPayload.filter_options.brands, state.pdvFilters.brand_ids)"
                        domain="getOptionDomain(pdvPayload.filter_options.brands)"
                        resModel="'zrn_commercial.commercial.brand'"
                        fieldString="'Marca'"
                        placeholder="'Todas las marcas'"
                        onChange.bind="this.onPdvBrandsChange"
                    />
                </div>
                <div class="zrn_analitics_pdv_field">
                    <label>Categoria</label>
                    <ZrnRelationalMultiSelect
                        records="getSelectedOptionRecords(pdvPayload.filter_options.categories, state.pdvFilters.category_ids)"
                        domain="getOptionDomain(pdvPayload.filter_options.categories)"
                        resModel="'product.category'"
                        fieldString="'Categoria'"
                        placeholder="'Todas las categorias'"
                        onChange.bind="this.onPdvCategoriesChange"
                    />
                </div>
                <div class="zrn_analitics_pdv_field">
                    <label>Canal</label>
                    <ZrnRelationalMultiSelect
                        records="getSelectedOptionRecords(pdvPayload.filter_options.channels, state.pdvFilters.channel_ids)"
                        domain="getOptionDomain(pdvPayload.filter_options.channels)"
                        resModel="'zrn_commercial.commercial.channel'"
                        fieldString="'Canal'"
                        placeholder="'Todos los canales'"
                        onChange.bind="this.onPdvChannelsChange"
                    />
                </div>
                <div class="zrn_analitics_pdv_field zrn_analitics_pdv_field_search">
                    <label>Buscar</label>
                    <input type="text" class="form-control" placeholder="PDV, cliente, producto o codigo" t-att-value="state.pdvFilters.search" t-on-input="(ev) => this.updatePdvFilter('search', ev.target.value)" t-on-keydown="this.onPdvSearchKeydown"/>
                </div>
            </div>
            <div class="zrn_analitics_pdv_actions">
                <button type="button" class="btn btn-primary" t-on-click="this.applyPdvFilters">Aplicar</button>
                <button type="button" class="btn btn-secondary" t-on-click="this.clearPdvFilters">Limpiar</button>
            </div>
        </section>
    </t>

    <t t-name="zrn_analitics.HubPdv">
        <div class="zrn_analitics_pdv_hub" t-ref="hubRoot">
            <div class="zrn_analitics_pdv_hero">
                <div class="zrn_analitics_pdv_title_row">
                    <div class="zrn_analitics_hub_panel_title">Hub PDV</div>
                </div>
            </div>

            <div class="zrn_analitics_pdv_shell">
                <button type="button" class="btn zrn_analitics_pdv_sidebar_toggle" t-on-click="togglePdvSidebar">
                    <i class="fa fa-bars"></i>
                    <span>Secciones</span>
                </button>

                <div class="zrn_analitics_pdv_sidebar_overlay" t-att-class="state.pdvSidebarOpen ? 'is-open' : ''" t-on-click="closePdvSidebar"></div>

                <aside class="zrn_analitics_pdv_sidebar" t-att-class="state.pdvSidebarOpen ? 'is-open' : ''">
                    <div class="zrn_analitics_pdv_sidebar_head">
                        <div class="zrn_analitics_pdv_sidebar_title">Secciones</div>
                        <button type="button" class="btn zrn_analitics_pdv_sidebar_close" t-on-click="closePdvSidebar">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>

                    <div class="zrn_analitics_pdv_badges">
                        <span class="zrn_analitics_pdv_badge zrn_analitics_pdv_badge_sync">
                            Sync con Odoo: <t t-esc="pdvPayload.summary.sync_label"/>
                        </span>
                        <span class="zrn_analitics_pdv_badge">
                            <t t-esc="pdvPayload.summary.period_label"/>
                        </span>
                        <span class="zrn_analitics_pdv_badge">
                            <t t-esc="formatCount(pdvPayload.summary.total_pdvs)"/> PDVs / <t t-esc="formatCount(pdvPayload.summary.active_channel_count)"/> canales
                        </span>
                    </div>

                    <div class="zrn_analitics_pdv_tabs">
                        <t t-foreach="pdvTabs" t-as="tab" t-key="tab.key">
                            <button
                                type="button"
                                class="btn zrn_analitics_pdv_tab"
                                t-att-class="state.pdvTab === tab.key ? 'is-active' : ''"
                                t-on-click="() => this.setPdvTab(tab.key)"
                            >
                                <i class="fa zrn_analitics_pdv_tab_icon" t-att-class="tab.icon"></i>
                                <span><t t-esc="tab.label"/></span>
                            </button>
                        </t>
                    </div>
                </aside>

                <div class="zrn_analitics_pdv_content">
                    <t t-if="state.pdvLoading">
                        <div class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_hub_panel_text">Cargando centro PDV...</div>
                        </div>
                    </t>

                    <t t-if="!state.pdvLoading">
                        <t t-call="zrn_analitics.HubPdvFilters"/>

                        <t t-if="pdvPayload.empty_message">
                            <div class="zrn_analitics_pdv_empty_note">
                                <t t-esc="pdvPayload.empty_message"/>
                            </div>
                        </t>

                        <t t-if="state.pdvTab === 'overview'">
                            <div class="zrn_analitics_pdv_stats">
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Revenue YTD</span>
                                    <strong><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(pdvPayload.summary.total_revenue)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>PDVs activos</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.total_pdvs)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Ticket promedio</span>
                                    <strong><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(pdvPayload.summary.avg_ticket)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>PDVs nuevos</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.new_count)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>PDVs con alertas</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.alert_count)"/></strong>
                                </div>
                            </div>

                            <div class="zrn_analitics_pdv_grid_top">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_pdv_panel_head">
                                        <span>Revenue por mes</span>
                                        <span>Venta filtrada por PDV</span>
                                    </div>
                                    <div class="zrn_analitics_pdv_chart_wrap">
                                        <t t-if="pdvPayload.revenue_series.length and hasEchartsLibrary">
                                            <div class="zrn_analitics_pdv_echart" data-zrn-chart="pdv-overview-revenue"></div>
                                        </t>
                                        <t t-elif="pdvPayload.revenue_series.length">
                                            <div class="zrn_analitics_pdv_chart_empty">Hay datos de revenue, pero ECharts no esta disponible.</div>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_pdv_chart_empty">Sin revenue para graficar.</div>
                                        </t>
                                    </div>
                                </section>

                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_pdv_panel_head">
                                        <span>Cobertura por canal</span>
                                        <span>PDVs activos vs red total</span>
                                    </div>
                                    <div class="zrn_analitics_pdv_chart_wrap">
                                        <t t-if="pdvPayload.channel_coverage.length and hasEchartsLibrary">
                                            <div class="zrn_analitics_pdv_echart" data-zrn-chart="pdv-overview-coverage"></div>
                                        </t>
                                        <t t-elif="pdvPayload.channel_coverage.length">
                                            <div class="zrn_analitics_pdv_chart_empty">Hay cobertura por canal, pero ECharts no esta disponible.</div>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_pdv_chart_empty">Sin cobertura para mostrar.</div>
                                        </t>
                                    </div>
                                </section>
                            </div>

                            <div class="zrn_analitics_pdv_grid_bottom">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_pdv_panel_head">
                                        <span>Top PDVs</span>
                                        <span>Revenue acumulado</span>
                                    </div>
                                    <div class="zrn_analitics_pdv_chart_wrap">
                                        <t t-if="pdvPayload.top_pdvs.length and hasEchartsLibrary">
                                            <div class="zrn_analitics_pdv_echart" data-zrn-chart="pdv-overview-top"></div>
                                        </t>
                                        <t t-elif="pdvPayload.top_pdvs.length">
                                            <div class="zrn_analitics_pdv_chart_empty">Hay top PDVs, pero ECharts no esta disponible.</div>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_pdv_chart_empty">Sin PDVs para mostrar.</div>
                                        </t>
                                    </div>
                                </section>

                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_pdv_panel_head">
                                        <span>Altas recientes y dormancia</span>
                                        <span>Senales operativas</span>
                                    </div>
                                    <div class="zrn_analitics_pdv_lists">
                                        <div class="zrn_analitics_pdv_list_block">
                                            <strong>PDVs nuevos</strong>
                                            <t t-if="pdvPayload.new_pdvs.length">
                                                <t t-foreach="pdvPayload.new_pdvs" t-as="row" t-key="'new_' + row.partner_id">
                                                    <button type="button" class="btn zrn_analitics_pdv_list_item" t-on-click="() => this.openPdvRow(row)">
                                                        <span><t t-esc="row.name_short"/></span>
                                                        <small><t t-esc="row.days_since_first"/> dias</small>
                                                    </button>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <div class="zrn_analitics_pdv_list_empty">Sin PDVs nuevos.</div>
                                            </t>
                                        </div>
                                        <div class="zrn_analitics_pdv_list_block">
                                            <strong>PDVs dormantes</strong>
                                            <t t-if="pdvPayload.dormant_pdvs.length">
                                                <t t-foreach="pdvPayload.dormant_pdvs" t-as="row" t-key="'dormant_' + row.partner_id">
                                                    <button type="button" class="btn zrn_analitics_pdv_list_item" t-on-click="() => this.openPdvRow(row)">
                                                        <span><t t-esc="row.name_short"/></span>
                                                        <small><t t-esc="row.days_since_last"/> dias</small>
                                                    </button>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <div class="zrn_analitics_pdv_list_empty">Sin PDVs dormantes.</div>
                                            </t>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </t>

                        <t t-if="state.pdvTab === 'ranking'">
                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Ranking de PDVs</span>
                                    <span><t t-esc="formatCount(pdvPayload.ranking_rows.length)"/> PDVs filtrados</span>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'rank')">#</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'name_short')">PDV</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'channel')">Canal</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'subchain')">Subcanal</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'rev')" class="text-end">Revenue</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'invoices')" class="text-end">Pedidos</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'avg_ticket')" class="text-end">Ticket</th>
                                                <th t-on-click="() => this.toggleSort('pdv_ranking', 'days_since_last')" class="text-end">Recencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvRanking" t-as="row" t-key="row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() => this.openPdvRow(row)">
                                                    <td><t t-esc="row.rank"/></td>
                                                    <td>
                                                        <strong><t t-esc="row.name_short"/></strong>
                                                        <div class="zrn_analitics_pdv_table_sub"><t t-esc="row.client_full"/></div>
                                                    </td>
                                                    <td><t t-esc="row.channel"/></td>
                                                    <td><t t-esc="row.subchain"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.rev)"/></td>
                                                    <td class="text-end"><t t-esc="formatCount(row.invoices)"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.avg_ticket)"/></td>
                                                    <td class="text-end"><t t-esc="row.days_since_last"/> d</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>

                        <t t-if="state.pdvTab === 'canales'">
                            <t t-set="channelComparePayload" t-value="pdvPayload.channel_compare"/>
                            <div class="zrn_analitics_pdv_stats zrn_analitics_pdv_stats_chain">
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Sell-in</span>
                                    <strong><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(channelComparePayload.summary.sellin_q)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Sell-out</span>
                                    <strong><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(channelComparePayload.summary.sellout_q)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Sell-through</span>
                                    <strong><t t-esc="formatPercent(channelComparePayload.summary.sellthrough_q_pct)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>PDVs con data</span>
                                    <strong><t t-esc="formatCount(channelComparePayload.summary.pdvs_with_data)"/></strong>
                                </div>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Sell-in vs Sell-out</span>
                                    <span><t t-esc="channelComparePayload.channel_labels.length ? channelComparePayload.channel_labels.join(', ') : 'Todos los canales'"/></span>
                                </div>
                                <div class="zrn_analitics_pdv_chart_wrap">
                                    <t t-if="channelComparePayload.by_month.length and hasEchartsLibrary">
                                        <div class="zrn_analitics_pdv_echart" data-zrn-chart="pdv-channel-monthly"></div>
                                    </t>
                                    <t t-elif="channelComparePayload.by_month.length">
                                        <div class="zrn_analitics_pdv_chart_empty">Hay datos mensuales, pero ECharts no esta disponible.</div>
                                    </t>
                                    <t t-elif="channelComparePayload.empty_message">
                                        <div class="zrn_analitics_pdv_chart_empty"><t t-esc="channelComparePayload.empty_message"/></div>
                                    </t>
                                    <t t-else="">
                                        <div class="zrn_analitics_pdv_chart_empty">Sin data mensual para los canales filtrados.</div>
                                    </t>
                                </div>
                            </section>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Detalle por PDV</span>
                                    <span><t t-esc="channelComparePayload.supported_channel_labels.length ? 'Click para drill-down' : 'Vista filtrada por canal'"/></span>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'name_short')">PDV</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'channel')">Canal</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'subchain')">Subcanal</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'sellin_q')" class="text-end">Sell-in</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'sellout_q')" class="text-end">Sell-out</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'sellthrough_q')" class="text-end">Sell-through</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'days_of_cover')" class="text-end">Cobertura</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvChannelRows" t-as="row" t-key="'pdv_channel_' + row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() => this.openPdvRow(row)">
                                                    <td><strong><t t-esc="row.name_short"/></strong></td>
                                                    <td><t t-esc="row.channel"/></td>
                                                    <td><t t-esc="row.subchain"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.has_sellout ? row.sellin_q : row.rev)"/></td>
                                                    <td class="text-end"><t t-esc="row.has_sellout ? pdvPayload.summary.currency_symbol + ' ' + formatMoney(row.sellout_q) : '—'"/></td>
                                                    <td class="text-end"><t t-esc="row.has_sellout ? formatPercent(row.sellthrough_q) : '—'"/></td>
                                                    <td class="text-end"><t t-esc="row.days_of_cover ? row.days_of_cover + ' d' : '—'"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>

                        <t t-if="false">
                            <t t-set="pumaPayload" t-value="pdvPayload.puma"/>
                            <div class="zrn_analitics_pdv_stats zrn_analitics_pdv_stats_chain">
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Sell-in</span>
                                    <strong><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(pumaPayload.summary.sellin_q)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Sell-out</span>
                                    <strong><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(pumaPayload.summary.sellout_q)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Sell-through</span>
                                    <strong><t t-esc="formatPercent(pumaPayload.summary.sellthrough_q_pct)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>PDVs con data</span>
                                    <strong><t t-esc="formatCount(pumaPayload.summary.pdvs_with_data)"/></strong>
                                </div>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Sell-in vs Sell-out</span>
                                    <span>PUMA Super 7</span>
                                </div>
                                <div class="zrn_analitics_pdv_chart_wrap">
                                    <t t-if="pumaPayload.by_month.length and hasEchartsLibrary">
                                        <div class="zrn_analitics_pdv_echart" data-zrn-chart="pdv-puma-monthly"></div>
                                    </t>
                                    <t t-elif="pumaPayload.by_month.length">
                                        <div class="zrn_analitics_pdv_chart_empty">Hay datos mensuales, pero ECharts no esta disponible.</div>
                                    </t>
                                    <t t-else="">
                                        <div class="zrn_analitics_pdv_chart_empty">Sin data mensual para PUMA Super 7.</div>
                                    </t>
                                </div>
                            </section>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Detalle por PDV</span>
                                    <span>Click para drill-down</span>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'name_short')">PDV</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'sellin_q')" class="text-end">Sell-in</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'sellout_q')" class="text-end">Sell-out</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'sellthrough_q')" class="text-end">Sell-through</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'days_since_last')" class="text-end">Recencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvPumaRows" t-as="row" t-key="'puma_' + row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() => this.openPdvRow(row)">
                                                    <td><strong><t t-esc="row.name_short"/></strong></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.sellin_q)"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.sellout_q)"/></td>
                                                    <td class="text-end"><t t-esc="row.has_sellout ? formatPercent(row.sellthrough_q) : '—'"/></td>
                                                    <td class="text-end"><t t-esc="row.days_since_last"/> d</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>

                        <t t-if="state.pdvTab === 'otros'">
                            <div class="zrn_analitics_pdv_grid_top">
                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_pdv_panel_head">
                                        <span>Cadenas adicionales</span>
                                        <span>Revenue por canal</span>
                                    </div>
                                    <div class="zrn_analitics_pdv_chart_wrap">
                                        <t t-if="pdvPayload.otros.channels.length and hasEchartsLibrary">
                                            <div class="zrn_analitics_pdv_echart" data-zrn-chart="pdv-otros-channels"></div>
                                        </t>
                                        <t t-elif="pdvPayload.otros.channels.length">
                                            <div class="zrn_analitics_pdv_chart_empty">Hay canales adicionales, pero ECharts no esta disponible.</div>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_pdv_chart_empty">Sin cadenas adicionales para mostrar.</div>
                                        </t>
                                    </div>
                                </section>

                                <section class="zrn_analitics_hub_panel">
                                    <div class="zrn_analitics_pdv_panel_head">
                                        <span>Canales incluidos</span>
                                        <span><t t-esc="formatCount(pdvPayload.otros.channels.length)"/> canales</span>
                                    </div>
                                    <div class="zrn_analitics_pdv_channel_list">
                                        <t t-if="pdvPayload.otros.channels.length">
                                            <t t-foreach="pdvPayload.otros.channels" t-as="row" t-key="'other_channel_' + row.channel">
                                                <div class="zrn_analitics_pdv_channel_item">
                                                    <strong><t t-esc="row.channel"/></strong>
                                                    <span><t t-esc="formatCount(row.active)"/> PDVs</span>
                                                    <span><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.revenue)"/></span>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="zrn_analitics_pdv_list_empty">Sin canales adicionales.</div>
                                        </t>
                                    </div>
                                </section>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Detalle de PDVs</span>
                                    <span>Click para drill-down</span>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'name_short')">PDV</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'channel')">Canal</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'rev')" class="text-end">Revenue</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'invoices')" class="text-end">Pedidos</th>
                                                <th t-on-click="() => this.toggleSort('pdv_chain', 'days_since_last')" class="text-end">Recencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvOtrosRows" t-as="row" t-key="'otros_' + row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() => this.openPdvRow(row)">
                                                    <td><strong><t t-esc="row.name_short"/></strong></td>
                                                    <td><t t-esc="row.channel"/></td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.rev)"/></td>
                                                    <td class="text-end"><t t-esc="formatCount(row.invoices)"/></td>
                                                    <td class="text-end"><t t-esc="row.days_since_last"/> d</td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>

                        <t t-if="state.pdvTab === 'alertas'">
                            <div class="zrn_analitics_pdv_stats zrn_analitics_pdv_stats_alerts">
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Dormantes</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.dormant_count)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Nuevos</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.new_count)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Low sell-through</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.low_st_count)"/></strong>
                                </div>
                                <div class="zrn_analitics_pdv_stat_box">
                                    <span>Total alertas</span>
                                    <strong><t t-esc="formatCount(pdvPayload.summary.alert_count)"/></strong>
                                </div>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_pdv_panel_head">
                                    <span>Alertas por PDV</span>
                                    <span>Click para drill-down</span>
                                </div>
                                <div class="zrn_analitics_pdv_table_wrap">
                                    <table class="zrn_analitics_pdv_table">
                                        <thead>
                                            <tr>
                                                <th t-on-click="() => this.toggleSort('pdv_alerts', 'name_short')">PDV</th>
                                                <th t-on-click="() => this.toggleSort('pdv_alerts', 'channel')">Canal</th>
                                                <th>Alertas</th>
                                                <th t-on-click="() => this.toggleSort('pdv_alerts', 'days_since_last')" class="text-end">Recencia</th>
                                                <th t-on-click="() => this.toggleSort('pdv_alerts', 'rev')" class="text-end">Revenue</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sortedPdvAlerts" t-as="row" t-key="'alert_' + row.partner_id">
                                                <tr class="zrn_analitics_pdv_row_clickable" t-on-click="() => this.openPdvRow(row)">
                                                    <td><strong><t t-esc="row.name_short"/></strong></td>
                                                    <td><t t-esc="row.channel"/></td>
                                                    <td>
                                                        <div class="zrn_analitics_pdv_alert_tags">
                                                            <t t-foreach="row.alerts" t-as="alert" t-key="alert.type">
                                                                <span class="zrn_analitics_pdv_alert_tag" t-att-class="'is-' + alert.sev"><t t-esc="alert.msg"/></span>
                                                            </t>
                                                        </div>
                                                    </td>
                                                    <td class="text-end"><t t-esc="row.days_since_last"/> d</td>
                                                    <td class="text-end"><t t-esc="pdvPayload.summary.currency_symbol"/> <t t-esc="formatMoney(row.rev)"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
