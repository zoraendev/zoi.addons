<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_analitics.HubRrhh">
        <div class="zrn_analitics_rrhh_hub" t-ref="hubRoot">
            <div class="zrn_analitics_commercial_hero">
                <div class="zrn_analitics_commercial_title_row">
                    <div class="zrn_analitics_hub_panel_title">Hub RRHH</div>
                </div>
            </div>

            <div class="zrn_analitics_commercial_shell">
                <button
                    type="button"
                    class="btn zrn_analitics_commercial_sidebar_toggle"
                    t-on-click="toggleCommercialSidebar"
                >
                    <i class="fa fa-bars"></i>
                    <span>Secciones</span>
                </button>

                <div
                    class="zrn_analitics_commercial_sidebar_overlay"
                    t-att-class="state.commercialSidebarOpen ? 'is-open' : ''"
                    t-on-click="closeCommercialSidebar"
                ></div>

                <aside
                    class="zrn_analitics_commercial_sidebar"
                    t-att-class="state.commercialSidebarOpen ? 'is-open' : ''"
                >
                    <div class="zrn_analitics_commercial_sidebar_head">
                        <div class="zrn_analitics_commercial_sidebar_title">Secciones</div>
                        <button
                            type="button"
                            class="btn zrn_analitics_commercial_sidebar_close"
                            t-on-click="closeCommercialSidebar"
                        >
                            <i class="fa fa-times"></i>
                        </button>
                    </div>

                    <div class="zrn_analitics_commercial_badges zrn_analitics_commercial_badges_sidebar">
                        <span class="zrn_analitics_commercial_badge zrn_analitics_commercial_badge_sync">
                            Sync con Odoo: <t t-esc="rrhhPayload.summary.sync_label"/>
                        </span>
                        <span class="zrn_analitics_commercial_badge">
                            <t t-esc="formatCount(rrhhPayload.summary.applicant_count)"/> solicitudes
                        </span>
                        <span class="zrn_analitics_commercial_badge">
                            <t t-esc="formatCount(rrhhPayload.summary.high_risk_count)"/> en riesgo alto
                        </span>
                    </div>

                    <div class="zrn_analitics_commercial_section_tabs">
                        <t t-foreach="rrhhTabs" t-as="tab" t-key="tab.key">
                            <button
                                type="button"
                                class="btn zrn_analitics_commercial_section_tab"
                                t-att-class="state.rrhhTab === tab.key ? 'is-active' : ''"
                                t-on-click="() => this.setRrhhTab(tab.key)"
                            >
                                <i class="fa zrn_analitics_commercial_section_tab_icon" t-att-class="tab.icon"></i>
                                <span><t t-esc="tab.label"/></span>
                            </button>
                        </t>
                    </div>
                </aside>

                <div class="zrn_analitics_commercial_content zrn_analitics_rrhh_content">
                    <t t-if="state.rrhhLoading">
                        <div class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_hub_panel_text">Cargando resumen de RRHH...</div>
                        </div>
                    </t>

                    <t t-if="!state.rrhhLoading &amp;&amp; rrhhPayload.empty_message">
                        <div class="zrn_analitics_commercial_empty_note">
                            <t t-esc="rrhhPayload.empty_message"/>
                        </div>
                    </t>

                    <t t-if="!state.rrhhLoading &amp;&amp; !rrhhPayload.empty_message &amp;&amp; state.rrhhTab === 'overview'">
                        <div class="zrn_analitics_commercial_stats">
                            <div class="zrn_analitics_commercial_stat_box">
                                <span>Solicitudes</span>
                                <strong><t t-esc="formatCount(rrhhPayload.summary.applicant_count)"/></strong>
                            </div>
                            <div class="zrn_analitics_commercial_stat_box">
                                <span>Con predictor</span>
                                <strong><t t-esc="formatCount(rrhhPayload.summary.predictor_count)"/></strong>
                            </div>
                            <div class="zrn_analitics_commercial_stat_box">
                                <span>Con checklist</span>
                                <strong><t t-esc="formatCount(rrhhPayload.summary.checklist_count)"/></strong>
                            </div>
                            <div class="zrn_analitics_commercial_stat_box">
                                <span>Riesgo alto</span>
                                <strong><t t-esc="formatCount(rrhhPayload.summary.high_risk_count)"/></strong>
                            </div>
                            <div class="zrn_analitics_commercial_stat_box">
                                <span>Pendientes</span>
                                <strong><t t-esc="formatCount(rrhhPayload.summary.pending_count)"/></strong>
                            </div>
                        </div>

                        <div class="zrn_analitics_commercial_top_row">
                            <section class="zrn_analitics_hub_panel zrn_analitics_commercial_panel_main">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Distribucion de riesgo</span>
                                    <span>Predictor por solicitud</span>
                                </div>
                                <div class="zrn_analitics_rrhh_chart_wrap">
                                    <t t-if="rrhhPayload.overview.risk_distribution.length &amp;&amp; hasEchartsLibrary">
                                        <div class="zrn_analitics_commercial_echart" data-zrn-chart="rrhh-risk-distribution"></div>
                                    </t>
                                    <t t-elif="rrhhPayload.overview.risk_distribution.length">
                                        <div class="zrn_analitics_commercial_chart_empty">Hay datos de riesgo, pero ECharts aun no esta cargado.</div>
                                    </t>
                                    <t t-else="">
                                        <div class="zrn_analitics_commercial_chart_empty">Sin evaluaciones para graficar.</div>
                                    </t>
                                </div>
                            </section>

                            <section class="zrn_analitics_hub_panel zrn_analitics_commercial_panel_side">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Solicitudes por etapa</span>
                                    <span>Pipeline actual</span>
                                </div>
                                <div class="zrn_analitics_rrhh_chart_wrap">
                                    <t t-if="rrhhPayload.overview.stage_distribution.length &amp;&amp; hasEchartsLibrary">
                                        <div class="zrn_analitics_commercial_echart" data-zrn-chart="rrhh-stage-distribution"></div>
                                    </t>
                                    <t t-elif="rrhhPayload.overview.stage_distribution.length">
                                        <div class="zrn_analitics_commercial_chart_empty">Hay etapas para graficar, pero ECharts aun no esta cargado.</div>
                                    </t>
                                    <t t-else="">
                                        <div class="zrn_analitics_commercial_chart_empty">Sin etapas para mostrar.</div>
                                    </t>
                                </div>
                            </section>
                        </div>

                        <div class="zrn_analitics_commercial_bottom_grid">
                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Ultimas solicitudes</span>
                                    <span>Seleccion o apertura rapida</span>
                                </div>
                                <div class="o_list_renderer o_list_view table-responsive">
                                    <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                        <thead>
                                            <tr>
                                                <th>Solicitud</th>
                                                <th>Puesto</th>
                                                <th>Etapa</th>
                                                <th>Predictor</th>
                                                <th>Checklist</th>
                                                <th>Patrones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="rrhhPayload.overview.latest_rows" t-as="row" t-key="row.applicant_id">
                                                <tr t-on-click="() => this.openRrhhApplicant(row.applicant_id)" style="cursor: pointer;">
                                                    <td>
                                                        <button
                                                            type="button"
                                                            class="btn btn-link p-0 text-decoration-none me-2"
                                                            t-on-click.stop="() => this.useRrhhHistoricalApplicant(row.applicant_id)"
                                                        >
                                                            Usar
                                                        </button>
                                                        <strong><t t-esc="row.name"/></strong>
                                                    </td>
                                                    <td><t t-esc="row.job_name || 'Sin puesto'"/></td>
                                                    <td><t t-esc="row.stage_name || 'Sin etapa'"/></td>
                                                    <td><t t-esc="row.predictor_risk_label"/></td>
                                                    <td><t t-esc="formatCount(row.checklist_alert_count)"/> alertas</td>
                                                    <td><t t-esc="formatCount(row.matched_pattern_count)"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_commercial_panel_head">
                                    <span>Puestos con mas solicitudes</span>
                                    <span>Distribucion actual</span>
                                </div>
                                <div class="zrn_analitics_rrhh_list">
                                    <t t-foreach="rrhhPayload.overview.job_distribution" t-as="row" t-key="row.label">
                                        <div class="zrn_analitics_rrhh_list_row">
                                            <span><t t-esc="row.label"/>:</span>
                                            <strong><t t-esc="formatCount(row.value)"/></strong>
                                        </div>
                                    </t>
                                </div>
                                <div class="zrn_analitics_rrhh_sources">
                                    <t t-foreach="rrhhPayload.notes_sources" t-as="source" t-key="source.label">
                                        <div class="zrn_analitics_rrhh_source_item">
                                            <strong><t t-esc="source.label"/>:</strong>
                                            <span><t t-esc="source.detail"/></span>
                                        </div>
                                    </t>
                                </div>
                            </section>
                        </div>
                    </t>

                    <t t-if="!state.rrhhLoading &amp;&amp; !rrhhPayload.empty_message &amp;&amp; state.rrhhTab === 'predictor'">
                        <section class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_commercial_panel_head">
                                <span>Solicitud activa</span>
                                <span>Scorecard predictivo</span>
                            </div>
                            <div class="zrn_analitics_rrhh_action_bar">
                                <div class="zrn_analitics_rrhh_selector">
                                    <label>Solicitud</label>
                                    <SelectMenu
                                        choices="getRrhhApplicantChoices(rrhhPayload.applicant_options)"
                                        value="rrhhPayload.active_filters.selected_applicant_id"
                                        onSelect.bind="this.selectRrhhApplicant"
                                    />
                                </div>
                                <button type="button" class="btn btn-secondary" t-on-click="recomputeRrhhPatterns">Recalcular patrones</button>
                            </div>
                        </section>

                        <t t-if="rrhhPayload.current_applicant">
                            <div class="zrn_analitics_commercial_stats">
                                <div class="zrn_analitics_commercial_stat_box">
                                    <span>Solicitud</span>
                                    <strong><t t-esc="rrhhPayload.current_applicant.name"/></strong>
                                </div>
                                <div class="zrn_analitics_commercial_stat_box">
                                    <span>Puesto</span>
                                    <strong><t t-esc="rrhhPayload.current_applicant.job_name || 'Sin puesto'"/></strong>
                                </div>
                                <div class="zrn_analitics_commercial_stat_box">
                                    <span>Etapa</span>
                                    <strong><t t-esc="rrhhPayload.current_applicant.stage_name || 'Sin etapa'"/></strong>
                                </div>
                                <div class="zrn_analitics_commercial_stat_box">
                                    <span>Score total</span>
                                    <strong><t t-esc="rrhhPayload.current_predictor ? rrhhPayload.current_predictor.score_total : '0.0'"/></strong>
                                </div>
                                <div class="zrn_analitics_commercial_stat_box">
                                    <span>Riesgo</span>
                                    <strong><t t-esc="rrhhPayload.current_predictor ? rrhhPayload.current_predictor.risk_label : 'Sin evaluar'"/></strong>
                                </div>
                            </div>

                            <section class="zrn_analitics_hub_panel">
                                <div class="zrn_analitics_rrhh_form_head">
                                    <div class="zrn_analitics_rrhh_field">
                                        <label>Fecha de evaluacion</label>
                                        <input type="date" class="form-control" t-att-value="state.rrhhPredictorForm.evaluation_date" t-on-input="(ev) => this.updateRrhhPredictorValue('evaluation_date', ev.target.value)"/>
                                    </div>
                                    <div class="zrn_analitics_rrhh_field zrn_analitics_rrhh_field_wide">
                                        <label>Observaciones</label>
                                        <textarea class="form-control" rows="2" t-on-input="(ev) => this.updateRrhhPredictorValue('notes', ev.target.value)"><t t-esc="state.rrhhPredictorForm.notes"/></textarea>
                                    </div>
                                </div>

                                <t t-foreach="rrhhPredictorFactors" t-as="factor" t-key="factor.key">
                                    <div class="zrn_analitics_rrhh_factor_block">
                                        <div class="zrn_analitics_rrhh_factor_head">
                                            <span class="zrn_analitics_rrhh_factor_badge"><t t-esc="factor.badge"/></span>
                                            <strong><t t-esc="factor.label"/></strong>
                                        </div>
                                        <t t-foreach="factor.questions" t-as="question" t-key="question.key">
                                            <div class="zrn_analitics_rrhh_question">
                                                <div class="zrn_analitics_rrhh_question_label"><t t-esc="question.label"/></div>
                                                <div class="zrn_analitics_rrhh_option_list">
                                                    <t t-foreach="question.options" t-as="option" t-key="option.value">
                                                        <label class="zrn_analitics_rrhh_option">
                                                            <input
                                                                type="radio"
                                                                t-att-name="question.key"
                                                                t-att-value="option.value"
                                                                t-att-checked="state.rrhhPredictorForm[question.key] === option.value ? true : undefined"
                                                                t-on-change="() => this.updateRrhhPredictorValue(question.key, option.value)"
                                                            />
                                                            <span><t t-esc="option.label"/></span>
                                                            <small><t t-esc="option.points"/> pts</small>
                                                        </label>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>

                                <div class="zrn_analitics_rrhh_result_box">
                                    <strong><t t-esc="rrhhPayload.current_predictor ? rrhhPayload.current_predictor.risk_label : 'Sin evaluar'"/></strong>
                                    <span><t t-esc="rrhhPayload.current_predictor ? rrhhPayload.current_predictor.summary_text : 'Guarde el predictor para calcular el riesgo.'"/></span>
                                </div>

                                <div class="zrn_analitics_rrhh_actions">
                                    <button type="button" class="btn btn-primary" t-on-click="saveRrhhPredictor">Guardar predictor</button>
                                </div>
                            </section>
                        </t>
                    </t>

                    <t t-if="!state.rrhhLoading &amp;&amp; !rrhhPayload.empty_message &amp;&amp; state.rrhhTab === 'patrones'">
                        <section class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_commercial_panel_head">
                                <span>Patrones validados</span>
                                <span><t t-esc="rrhhPayload.current_applicant ? rrhhPayload.current_applicant.name : 'Seleccione una solicitud'"/></span>
                            </div>

                            <div class="zrn_analitics_rrhh_non_predictive">
                                <t t-foreach="rrhhPayload.validated_patterns.non_predictive_factors" t-as="factor" t-key="factor">
                                    <span class="zrn_analitics_rrhh_chip"><t t-esc="factor"/></span>
                                </t>
                            </div>

                            <div class="zrn_analitics_rrhh_result_box">
                                <strong><t t-esc="rrhhPayload.current_patterns.summary_text"/></strong>
                                <span>
                                    <t t-esc="formatCount(rrhhPayload.current_patterns.matched_pattern_count)"/> patrones activos para la solicitud seleccionada.
                                </span>
                            </div>

                            <div class="zrn_analitics_rrhh_pattern_grid">
                                <t t-foreach="rrhhPayload.current_patterns.patterns" t-as="pattern" t-key="pattern.key">
                                    <div class="zrn_analitics_rrhh_pattern_card" t-att-class="pattern.matched ? 'is-matched' : ''">
                                        <div class="zrn_analitics_rrhh_pattern_head">
                                            <strong><t t-esc="pattern.label"/></strong>
                                            <span><t t-esc="pattern.strength"/></span>
                                        </div>
                                        <div class="zrn_analitics_rrhh_pattern_stats">
                                            <span>Aprobados: <t t-esc="pattern.approved_pct"/>%</span>
                                            <span>No aprobados: <t t-esc="pattern.rejected_pct"/>%</span>
                                        </div>
                                        <div class="zrn_analitics_rrhh_pattern_desc"><t t-esc="pattern.description"/></div>
                                    </div>
                                </t>
                            </div>
                        </section>
                    </t>

                    <t t-if="!state.rrhhLoading &amp;&amp; !rrhhPayload.empty_message &amp;&amp; state.rrhhTab === 'checklist'">
                        <section class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_commercial_panel_head">
                                <span>Checklist de entrevista</span>
                                <span><t t-esc="rrhhPayload.current_applicant ? rrhhPayload.current_applicant.name : 'Seleccione una solicitud'"/></span>
                            </div>
                            <div class="zrn_analitics_rrhh_form_head">
                                <div class="zrn_analitics_rrhh_field">
                                    <label>Fecha de entrevista</label>
                                    <input type="date" class="form-control" t-att-value="state.rrhhChecklistForm.interview_date" t-on-input="(ev) => this.updateRrhhChecklistValue('interview_date', ev.target.value)"/>
                                </div>
                                <div class="zrn_analitics_rrhh_field zrn_analitics_rrhh_field_wide">
                                    <label>Observaciones</label>
                                    <textarea class="form-control" rows="2" t-on-input="(ev) => this.updateRrhhChecklistValue('observations', ev.target.value)"><t t-esc="state.rrhhChecklistForm.observations"/></textarea>
                                </div>
                            </div>

                            <div class="zrn_analitics_rrhh_result_box">
                                <strong><t t-esc="rrhhPayload.current_checklist ? rrhhPayload.current_checklist.summary_text : 'Marque las alertas detectadas durante la entrevista.'"/></strong>
                                <span>
                                    <t t-esc="rrhhPayload.current_checklist ? formatCount(rrhhPayload.current_checklist.alert_count) : '0'"/> alertas registradas.
                                </span>
                            </div>

                            <div class="zrn_analitics_rrhh_checklist_grid">
                                <t t-foreach="rrhhPayload.checklist_template.sections" t-as="section" t-key="section.key">
                                    <div class="zrn_analitics_rrhh_checklist_block">
                                        <div class="zrn_analitics_rrhh_factor_head">
                                            <strong><t t-esc="section.label"/></strong>
                                        </div>
                                        <t t-foreach="section.items" t-as="item" t-key="item.key">
                                            <label class="zrn_analitics_rrhh_check_item">
                                                <input
                                                    type="checkbox"
                                                    t-att-checked="state.rrhhChecklistForm[item.key] ? true : undefined"
                                                    t-on-change="(ev) => this.updateRrhhChecklistValue(item.key, ev.target.checked)"
                                                />
                                                <span><t t-esc="item.label"/></span>
                                            </label>
                                            <div class="zrn_analitics_rrhh_check_help"><t t-esc="item.alert"/></div>
                                        </t>
                                    </div>
                                </t>
                            </div>

                            <div class="zrn_analitics_rrhh_actions">
                                <button type="button" class="btn btn-primary" t-on-click="saveRrhhChecklist">Guardar checklist</button>
                            </div>
                        </section>
                    </t>

                    <t t-if="!state.rrhhLoading &amp;&amp; !rrhhPayload.empty_message &amp;&amp; state.rrhhTab === 'historico'">
                        <section class="zrn_analitics_hub_panel">
                            <div class="zrn_analitics_commercial_panel_head">
                                <span>Historico de solicitudes</span>
                                <span><t t-esc="formatCount(sortedRrhhHistorical.length)"/> registros</span>
                            </div>
                            <div class="zrn_analitics_rrhh_history_filters">
                                <div class="zrn_analitics_rrhh_field">
                                    <label>Riesgo</label>
                                    <SelectMenu
                                        choices="getRrhhRiskChoices(rrhhPayload.predictor_config.thresholds)"
                                        value="state.rrhhHistoryRisk"
                                        onSelect.bind="this.onRrhhHistoryRiskSelect"
                                    />
                                </div>
                                <div class="zrn_analitics_rrhh_field zrn_analitics_rrhh_field_wide">
                                    <label>Buscar</label>
                                    <input type="text" class="form-control" placeholder="Solicitud, puesto, etapa o patron" t-att-value="state.rrhhHistorySearch" t-on-input="(ev) => this.state.rrhhHistorySearch = ev.target.value"/>
                                </div>
                            </div>
                            <div class="o_list_renderer o_list_view table-responsive">
                                <table class="o_list_table table table-sm table-hover position-relative mb-0 table-striped">
                                    <thead>
                                        <tr>
                                            <th>Accion</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'name')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Solicitud</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'job_name')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Puesto</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'stage_name')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Etapa</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'predictor_score')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Score</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'predictor_risk_label')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Riesgo</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'checklist_alert_count')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Checklist</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'matched_pattern_count')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Patrones</th>
                                            <th t-on-click="() => this.toggleSort('rrhh_historical', 'created_at')" class="o_column_sortable" style="cursor: pointer; user-select: none;">Creada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="sortedRrhhHistorical" t-as="row" t-key="row.applicant_id">
                                            <tr t-on-click="() => this.openRrhhApplicant(row.applicant_id)" style="cursor: pointer;">
                                                <td>
                                                    <button
                                                        type="button"
                                                        class="btn btn-link p-0 text-decoration-none"
                                                        t-on-click.stop="() => this.useRrhhHistoricalApplicant(row.applicant_id)"
                                                    >
                                                        Cargar
                                                    </button>
                                                </td>
                                                <td><strong><t t-esc="row.name"/></strong></td>
                                                <td><t t-esc="row.job_name || 'Sin puesto'"/></td>
                                                <td><t t-esc="row.stage_name || 'Sin etapa'"/></td>
                                                <td><t t-esc="row.predictor_score"/></td>
                                                <td><t t-esc="row.predictor_risk_label"/></td>
                                                <td><t t-esc="formatCount(row.checklist_alert_count)"/></td>
                                                <td><t t-esc="formatCount(row.matched_pattern_count)"/></td>
                                                <td><t t-esc="row.created_at"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
