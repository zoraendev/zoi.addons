<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_analitics.FormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <div class="zrn_analitics_cp_actions" t-if="showHeaderBackButton">
                    <button type="button" class="btn zrn_analitics_cp_btn zrn_analitics_cp_btn_ghost zrn_processing_leave_btn" t-on-click="openHeaderBack">
                        <t t-esc="headerBackLabel"/>
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>
