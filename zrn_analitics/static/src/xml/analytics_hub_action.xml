<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_analitics.HubAction">
        <div class="zrn_analitics_hub_workspace">
            <div class="zrn_analitics_hub_header">
                <div class="zrn_analitics_hub_header_actions">
                    <button
                        type="button"
                        class="btn zrn_analitics_hub_back_btn"
                        t-on-click="openHome"
                    >
                        <i class="fa fa-arrow-left"></i>
                        <span>Regresar</span>
                    </button>
                </div>
                <div class="zrn_analitics_hub_tabs_shell">
                    <div class="zrn_analitics_hub_tabs">
                        <t t-foreach="hubs" t-as="hub" t-key="hub.key">
                            <button
                                type="button"
                                class="btn zrn_analitics_hub_tab"
                                t-att-class="state.activeHub === hub.key ? 'zrn_analitics_hub_tab_active' : ''"
                                t-on-click="() => this.setActiveHub(hub.key)"
                            >
                                <t t-esc="hub.label"/>
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <div class="zrn_analitics_hub_body">
                <t t-if="activeHub.key === 'direction'" t-call="zrn_analitics.HubDirection"/>
                <t t-if="activeHub.key === 'commercial'" t-call="zrn_analitics.HubCommercial"/>
                <t t-if="activeHub.key === 'financial'" t-call="zrn_analitics.HubFinancial"/>
                <t t-if="activeHub.key === 'operations'" t-call="zrn_analitics.HubOperations"/>
                <t t-if="activeHub.key === 'pdv'" t-call="zrn_analitics.HubPdv"/>
                <t t-if="activeHub.key === 'rrhh'" t-call="zrn_analitics.HubRrhh"/>
            </div>
        </div>
    </t>
</templates>
