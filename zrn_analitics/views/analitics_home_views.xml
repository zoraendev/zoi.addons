<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="zrn_analitics_home_default" model="zrn_analitics.home">
        <field name="name">Zoraen Analitics</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="zrn_analitics_workspace_default" model="zrn_analitics.home">
        <field name="name">Zoraen Analitics</field>
        <field name="sequence">20</field>
        <field name="page_key">workspace</field>
    </record>

    <record id="view_zrn_analitics_home_form" model="ir.ui.view">
        <field name="name">zrn_analitics.home.form</field>
        <field name="model">zrn_analitics.home</field>
        <field name="arch" type="xml">
            <form string="Zoraen Analitics" js_class="zrn_analitics_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_analitics_form_shell">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>

                    <div class="zrn_analitics_shell" invisible="page_key != 'overview'">
                        <div class="zrn_analitics_header">
                            <div>
                                <div class="zrn_analitics_kicker">Zoraen Analitics</div>
                                <div class="oe_title">
                                    <h1>Centro de analitica</h1>
                                </div>
                                <div class="zrn_analitics_intro">
                                    Base inicial para hubs, dashboards y procesamiento de datos orientados a reporteria y analisis de negocio.
                                </div>
                            </div>
                            <div class="zrn_analitics_stats">
                                <div class="zrn_analitics_stat">
                                    <span class="zrn_analitics_stat_label">Capas</span>
                                    <span class="zrn_analitics_stat_value">3</span>
                                </div>
                                <div class="zrn_analitics_stat">
                                    <span class="zrn_analitics_stat_label">Estado</span>
                                    <span class="zrn_analitics_stat_value">Base</span>
                                </div>
                                <div class="zrn_analitics_stat">
                                    <span class="zrn_analitics_stat_label">Foco</span>
                                    <span class="zrn_analitics_stat_value">KPIs</span>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_analitics_block">
                            <div class="zrn_analitics_section_title">Frentes analiticos</div>
                            <div class="zrn_analitics_menu">
                                <button
                                    name="action_open_hubs"
                                    type="object"
                                    icon="fa-th-large"
                                    string="Hubs"
                                    class="btn zrn_analitics_menu_btn zrn_analitics_menu_btn_primary"
                                />
                                <button
                                    name="action_open_dashboards"
                                    type="object"
                                    icon="fa-bar-chart"
                                    string="Dashboards"
                                    class="btn zrn_analitics_menu_btn zrn_analitics_menu_btn_secondary"
                                />
                                <button
                                    name="action_open_processing"
                                    type="object"
                                    icon="fa-database"
                                    string="Procesamiento"
                                    class="btn zrn_analitics_menu_btn zrn_analitics_menu_btn_tertiary"
                                />
                            </div>
                        </div>

                        <div class="zrn_analitics_grid">
                            <div class="zrn_analitics_panel zrn_analitics_panel_wide">
                                <div class="zrn_analitics_panel_head">
                                    <span>Hubs priorizados</span>
                                    <span>Vista inicial</span>
                                </div>
                                <div class="zrn_analitics_panel_body zrn_analitics_placeholder_list">
                                    <div class="zrn_analitics_placeholder_row"/>
                                    <div class="zrn_analitics_placeholder_row"/>
                                    <div class="zrn_analitics_placeholder_row"/>
                                    <div class="zrn_analitics_placeholder_row"/>
                                </div>
                            </div>

                            <div class="zrn_analitics_panel">
                                <div class="zrn_analitics_panel_head">
                                    <span>Origenes</span>
                                    <span>Fuentes y capas</span>
                                </div>
                                <div class="zrn_analitics_panel_body zrn_analitics_placeholder_chart">
                                    <div class="zrn_analitics_placeholder_bars">
                                        <div/>
                                        <div/>
                                        <div/>
                                        <div/>
                                        <div/>
                                    </div>
                                </div>
                            </div>

                            <div class="zrn_analitics_panel">
                                <div class="zrn_analitics_panel_head">
                                    <span>Pipeline</span>
                                    <span>Preparacion de datos</span>
                                </div>
                                <div class="zrn_analitics_panel_body zrn_analitics_placeholder_flow">
                                    <span/>
                                    <span/>
                                    <span/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="zrn_analitics_shell" invisible="page_key != 'workspace'">
                        <div class="zrn_analitics_header zrn_analitics_header_workspace">
                            <div>
                                <div class="zrn_analitics_kicker">Workspace</div>
                                <div class="oe_title">
                                    <h1>Espacio analitico</h1>
                                </div>
                                <div class="zrn_analitics_intro">
                                    Pantalla reservada para alojar hubs, dashboards y exploraciones de datos conforme se separen del addon original.
                                </div>
                            </div>
                            <div class="zrn_analitics_header_actions">
                                <button
                                    name="action_open_home"
                                    type="object"
                                    icon="fa-arrow-left"
                                    string="Volver al centro"
                                    class="btn zrn_analitics_back_btn"
                                />
                            </div>
                        </div>

                        <div class="zrn_analitics_workspace_cards">
                            <div class="zrn_analitics_workspace_card">
                                <div class="zrn_analitics_workspace_title">Hub ejecutivo</div>
                                <div class="zrn_analitics_workspace_text">Espacio listo para indicadores de direccion y seguimiento agregado.</div>
                            </div>
                            <div class="zrn_analitics_workspace_card">
                                <div class="zrn_analitics_workspace_title">Hub comercial</div>
                                <div class="zrn_analitics_workspace_text">Reservado para reporteria comercial y comparativos por canal, cliente y marca.</div>
                            </div>
                            <div class="zrn_analitics_workspace_card">
                                <div class="zrn_analitics_workspace_title">Procesamiento</div>
                                <div class="zrn_analitics_workspace_text">Base para jobs, transformaciones y capas intermedias de datos.</div>
                            </div>
                            <div class="zrn_analitics_workspace_card">
                                <div class="zrn_analitics_workspace_title">Modelos futuros</div>
                                <div class="zrn_analitics_workspace_text">Este frente quedo listo para crecer por dominios sin mezclar planeacion ni comercial operativo.</div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_analitics_home" model="ir.actions.act_window">
        <field name="name">Zoraen Analitics</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_home_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_home_default'), 'active_ids': [ref('zrn_analitics_home_default'), ref('zrn_analitics_workspace_default')]}"/>
    </record>

    <record id="action_zrn_analitics_workspace" model="ir.actions.act_window">
        <field name="name">Workspace Analitico</field>
        <field name="res_model">zrn_analitics.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_analitics_home_form"/>
        <field name="res_id" ref="zrn_analitics_workspace_default"/>
        <field name="target">current</field>
        <field name="context" eval="{'active_id': ref('zrn_analitics_workspace_default'), 'active_ids': [ref('zrn_analitics_home_default'), ref('zrn_analitics_workspace_default')]}"/>
    </record>

    <menuitem
        id="menu_zrn_analitics_root"
        name="Zoraen Analitics"
        sequence="15"
        action="action_zrn_analitics_home"
        web_icon="zrn_analitics,static/description/icon.png"
    />

    <menuitem
        id="menu_zrn_analitics_workspace"
        name="Workspace"
        parent="menu_zrn_analitics_root"
        sequence="20"
        action="action_zrn_analitics_workspace"
    />

</odoo>
