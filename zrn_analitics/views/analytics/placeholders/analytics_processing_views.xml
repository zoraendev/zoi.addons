<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_analitics_home_form_processing" model="ir.ui.view">
        <field name="name">zrn_analitics.home.form.processing</field>
        <field name="model">zrn_analitics.home</field>
        <field name="inherit_id" ref="zrn_analitics.view_zrn_analitics_home_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="zrn_analitics_shell" invisible="page_key != 'processing'">
                    <div class="zrn_analitics_header zrn_analitics_header_workspace">
                        <div>
                            <div class="oe_title">
                                <h1>Centro de carga</h1>
                            </div>
                            <div class="zrn_processing_warning">
                                El archivo y la consulta viven solo en esta sesion del navegador. Si sales, recargas o cierras la pagina, se perderan.
                            </div>
                        </div>
                    </div>

                    <button
                        name="action_open_processing_workspace"
                        type="object"
                        string="Abrir workspace temporal"
                        class="btn btn-link zrn_processing_workspace_trigger"
                    />

                    <div class="zrn_processing_app" data-zrn-processing-root="1" data-zrn-processing-screen="landing">
                        <div class="zrn_processing_panel">
                            <div class="zrn_processing_panel_head">
                                <strong>Carga de archivo</strong>
                                <span>Entrada principal de procesamiento</span>
                            </div>
                            <div class="zrn_processing_panel_body">
                                <div class="zrn_processing_field">
                                    <div class="o_form_label">Archivo local</div>
                                    <input
                                        type="file"
                                        class="form-control"
                                        data-action="file"
                                        accept=".csv,.json,.xml,.xls,.xlsx,.xlsm"
                                    />
                                    <div class="zrn_processing_field_hint">
                                        Al cargar el archivo se abrira el workspace temporal de consultas y resultados.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="zrn_analitics_shell zrn_processing_shell_mode" invisible="page_key != 'processing_workspace'">
                    <div class="zrn_processing_app" data-zrn-processing-root="1" data-zrn-processing-screen="workspace"></div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
