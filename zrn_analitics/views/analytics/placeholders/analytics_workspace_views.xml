<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_analitics_home_form_workspace" model="ir.ui.view">
        <field name="name">zrn_analitics.home.form.workspace</field>
        <field name="model">zrn_analitics.home</field>
        <field name="inherit_id" ref="zrn_analitics.view_zrn_analitics_home_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="zrn_analitics_shell" invisible="page_key != 'workspace'">
                    <div class="zrn_analitics_header zrn_analitics_header_workspace">
                        <div>
                            <div class="zrn_analitics_kicker">Workspace</div>
                            <div class="oe_title">
                                <h1>Espacio analitico</h1>
                            </div>
                            <div class="zrn_analitics_intro">
                                Pantalla reservada para alojar hubs, dashboards y exploraciones de datos conforme se separen del addon original.
                            </div>
                        </div>
                        <div class="zrn_analitics_header_actions">
                            <button
                                name="action_open_home"
                                type="object"
                                icon="fa-arrow-left"
                                string="Volver al centro"
                                class="btn zrn_analitics_back_btn"
                            />
                        </div>
                    </div>

                    <div class="zrn_analitics_workspace_cards">
                        <div class="zrn_analitics_workspace_card">
                            <div class="zrn_analitics_workspace_title">Hub ejecutivo</div>
                            <div class="zrn_analitics_workspace_text">Espacio listo para indicadores de direccion y seguimiento agregado.</div>
                        </div>
                        <div class="zrn_analitics_workspace_card">
                            <div class="zrn_analitics_workspace_title">Hub comercial</div>
                            <div class="zrn_analitics_workspace_text">Reservado para reporteria comercial y comparativos por canal, cliente y marca.</div>
                        </div>
                        <div class="zrn_analitics_workspace_card">
                            <div class="zrn_analitics_workspace_title">Procesamiento</div>
                            <div class="zrn_analitics_workspace_text">Base para jobs, transformaciones y capas intermedias de datos.</div>
                        </div>
                        <div class="zrn_analitics_workspace_card">
                            <div class="zrn_analitics_workspace_title">Modelos futuros</div>
                            <div class="zrn_analitics_workspace_text">Este frente quedo listo para crecer por dominios sin mezclar planeacion ni comercial operativo.</div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
