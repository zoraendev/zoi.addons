<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pbi_connections_inicio_default" model="pbi_connections.inicio">
        <field name="name">PBI Connections</field>
    </record>

    <record id="view_pbi_connections_endpoint_tree" model="ir.ui.view">
        <field name="name">pbi_connections.endpoint.tree</field>
        <field name="model">pbi_connections.endpoint</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_pbi_connections_endpoint_form" model="ir.ui.view">
        <field name="name">pbi_connections.endpoint.form</field>
        <field name="model">pbi_connections.endpoint</field>
        <field name="arch" type="xml">
            <form string="Endpoint">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="technical_name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pbi_connections_endpoint" model="ir.actions.act_window">
        <field name="name">Endpoints</field>
        <field name="res_model">pbi_connections.endpoint</field>
        <field name="view_mode">tree,form</field>
        <field name="views" eval="[(ref('view_pbi_connections_endpoint_tree'), 'tree'), (ref('view_pbi_connections_endpoint_form'), 'form')]"/>
        <field name="target">current</field>
    </record>

    <record id="view_pbi_connections_inicio_form" model="ir.ui.view">
        <field name="name">pbi_connections.inicio.form</field>
        <field name="model">pbi_connections.inicio</field>
        <field name="arch" type="xml">
            <form string="PBI Connections" js_class="pbi_connections_home_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_pbi_connections_home_form">
                <field name="name" invisible="1"/>
                <field name="show_dashboard" invisible="1"/>
                <field name="client_validation_state" invisible="1"/>
                <field name="client_status_code" invisible="1"/>
                <field name="support_url" invisible="1"/>
                <field name="client_validation_debug" invisible="1"/>

                <div class="zrn_pbi_dashboard">
                    <div class="zrn_pbi_dashboard_header">
                        <h1>PBI Connections</h1>
                        <p>
                            Centraliza la conexion, credenciales y puntos de acceso que usa Power BI para consumir informacion desde Odoo.
                        </p>
                    </div>

                    <div class="zrn_pbi_blocked_state" invisible="show_dashboard">
                        <div class="alert zrn_pbi_blocked_banner" role="alert">
                            <div class="zrn_pbi_blocked_banner_content">
                                <h3>
                                    <field name="client_status_title" readonly="1" nolabel="1" class="oe_inline"/>
                                </h3>
                                <p>
                                    <field name="client_status_message" readonly="1" nolabel="1" class="oe_inline"/>
                                </p>
                                <p class="text-muted" invisible="not client_validation_debug">
                                    <field name="client_validation_debug" readonly="1" nolabel="1" class="oe_inline"/>
                                </p>
                                <div class="zrn_pbi_tile_actions zrn_pbi_center_actions">
                                    <button
                                        name="action_open_settings"
                                        type="object"
                                        string="Abrir ajustes"
                                        class="btn btn-primary"
                                    />
                                    <button
                                        name="action_request_support"
                                        type="object"
                                        string="Contactar soporte"
                                        class="btn btn-secondary"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>

                    <sheet invisible="not show_dashboard">
                        <div class="oe_title d-flex align-items-center justify-content-between zrn_pbi_main_head">
                            <h2>
                                <field name="name" readonly="1"/>
                            </h2>
                            <button
                                name="action_generate_new_token"
                                string="Generar"
                                type="object"
                                class="btn btn-primary zrn_pbi_generate_btn"
                                confirm="Power BI perdera acceso hasta que actualices su conexion actual."
                            />
                        </div>

                        <group>
                            <group name="left_panel">
                                <field name="access_token" readonly="1"/>
                                <field name="record_limit"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Conexion Power BI" name="api_connection">
                                <group>
                                    <field name="api_url" widget="CopyClipboardChar" readonly="1" string="URL segura de referencia"/>
                                </group>
                                <div class="alert mt-3 zrn_pbi_help_callout zrn_pbi_help_callout_info" role="alert">
                                    <strong>Uso recomendado:</strong><br/>
                                    Utiliza el valor de <em>Token de Acceso</em> en la cabecera <code>Access-Token</code> o <code>Authorization: Bearer ...</code>.
                                </div>
                                <div class="alert mt-3 zrn_pbi_help_callout zrn_pbi_help_callout_warning" role="alert">
                                    <strong>Precaucion:</strong><br/>
                                    Protege este token como si fuera una contrasena. Cualquier persona con este valor podra consumir los endpoints publicados.
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </div>
            </form>
        </field>
    </record>

    <record id="action_pbi_connections_inicio" model="ir.actions.act_window">
        <field name="name">PBI Connections</field>
        <field name="res_model">pbi_connections.inicio</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pbi_connections_inicio_form"/>
        <field name="res_id" ref="pbi_connections_inicio_default"/>
        <field name="target">current</field>
    </record>

</odoo>
