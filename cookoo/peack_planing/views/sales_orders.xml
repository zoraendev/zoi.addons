<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_peack_planing_report_wizard_form" model="ir.ui.view">
        <field name="name">peack_planing.sales_orders.form</field>
        <field name="model">peack_planing.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Planeación de Fabricación" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_generate_report" type="object" string="Generar reporte" class="btn btn-primary"/>
                    <button name="action_clear_filters" type="object" string="Limpiar" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <group invisible="1">
                        <field name="name"/>
                        <field name="available_cliente_ids"/>
                        <field name="available_product_ids"/>
                    </group>

                    <group string="Filtros de Planeación">
                        <group>
                            <field name="fecha_entrega_desde"/>
                            <field name="fecha_entrega_hasta"/>
                            <field name="sale_order_state" placeholder="Todos los estados"/>
                        </group>
                        <group>
                            <field
                                name="cliente_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', available_cliente_ids)]"
                                context="{'show_address': 1, 'show_vat': True}"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                placeholder="Selecciona uno o varios clientes"
                            />
                            <field
                                name="product_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', available_product_ids)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                placeholder="Selecciona uno o varios productos"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" type="object" string="Continuar" class="btn btn-primary"/>
                    <button name="action_clear_filters" type="object" string="Limpiar" class="btn btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_peack_planing_report_wizard_report_form" model="ir.ui.view">
        <field name="name">peack_planing.sales_orders.report.form</field>
        <field name="model">peack_planing.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Detalle del reporte" create="0" edit="0" delete="0" duplicate="0" class="zrn_peack_planing_sales_orders_form" js_class="peack_planing_report_form">
                <sheet>
                    <div class="zrn_am_report_screen">
                        <div class="zrn_am_report_screen_header">
                            <div class="zrn_pp_header_main">
                                <div class="zrn_pp_header_titles">
                                    <h2>Detalle operativo</h2>
                                    <p>
                                        Vista agrupada por producto, cliente y orden de venta usando la seleccion definida en la pantalla anterior.
                                    </p>
                                    <div class="zrn_pp_header_actions mt-3">
                                        <button type="button" name="btn_save_filters" class="btn btn-secondary btn-sm zrn_am_save_filters_btn" title="Guardar filtros">
                                            <i class="fa fa-save"></i> Guardar Filtros
                                        </button>
                                        <button type="button" name="btn_toggle_view" class="btn btn-secondary btn-sm zrn_pp_toggle_view_btn ms-2" title="Cambiar vista">
                                            <i class="fa fa-th"></i> Cambiar Vista
                                        </button>
                                    </div>
                                </div>
                                <p class="zrn_am_report_range">
                                    <field name="report_date_range_label" readonly="1" nolabel="1"/>
                                </p>
                            </div>
                            <div class="zrn_am_report_screen_stats">
                                <div class="zrn_am_report_stat_box">
                                    <span>Clientes</span>
                                    <strong><field name="report_customer_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>Productos</span>
                                    <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>OVs</span>
                                    <strong><field name="report_order_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>Lineas</span>
                                    <strong><field name="report_row_count" readonly="1" nolabel="1"/></strong>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_am_report_table_panel">
                            <field name="report_html" widget="html" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_back_to_filters" type="object" string="Volver a filtros" class="btn btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_peack_planing_report_wizard_production_form" model="ir.ui.view">
        <field name="name">peack_planing.sales_orders.production.form</field>
        <field name="model">peack_planing.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen para fabricar" create="0" edit="0" delete="0" duplicate="0" class="zrn_peack_planing_sales_orders_form" js_class="peack_planing_production_form">
                <sheet>
                    <div class="zrn_am_report_screen zrn_am_production_screen">
                        <div class="zrn_am_report_screen_header">
                            <div>
                                <h2>Resumen para fabricar</h2>
                                <p>
                                    Consolidado por producto para revisar demanda, inventario disponible y cantidad sugerida a producir.
                                </p>
                                <p class="zrn_am_report_range">
                                    <field name="report_date_range_label" readonly="1" nolabel="1"/>
                                </p>
                            </div>
                            <div class="zrn_am_report_screen_stats">
                                <div class="zrn_am_report_stat_box">
                                    <span>Clientes</span>
                                    <strong><field name="report_customer_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>Productos</span>
                                    <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>OVs</span>
                                    <strong><field name="report_order_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>Lineas</span>
                                    <strong><field name="report_row_count" readonly="1" nolabel="1"/></strong>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_am_report_table_panel">
                            <field name="production_html" widget="html" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_back_to_report" type="object" string="Volver al reporte" class="btn btn-secondary"/>
                    <button name="action_back_to_filters" type="object" string="Volver a filtros" class="btn btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action is now defined in views.xml to resolve circular dependency -->

    <record id="view_peack_planing_inicio_form_report_link" model="ir.ui.view">
        <field name="name">peack_planing.inicio.form.report.link</field>
        <field name="model">peack_planing.inicio</field>
        <field name="inherit_id" ref="peack_planing.view_peack_planing_inicio_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside"/>
        </field>
    </record>

</odoo>
