<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_peack_planing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.peack_planing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Advanced Metrics" name="peack_planing">
                    <block title="Credenciales de integracion" name="peack_planing_settings">
                        <setting id="peack_planing_instance_key_setting" string="Key de instancia" help="Clave usada para redireccionar a la instancia y al soporte en ADM.">
                            <field name="peack_planing_instance_key"/>
                        </setting>

                        <setting id="peack_planing_client_validation_base_url_setting" string="URL base de validacion" help="URL base del servicio. La peticion final se arma como /clients/key/&lt;clave_cliente&gt;.">
                            <field name="peack_planing_client_validation_base_url"/>
                        </setting>

                        <setting id="peack_planing_client_key_setting" string="Clave de cliente" help="Clave unica del cliente utilizada para consultar el estado del servicio. Se envia en la URL.">
                            <field name="peack_planing_client_key" password="True"/>
                        </setting>

                        <setting id="peack_planing_client_validation_api_key_setting" string="API Key de validacion" help="API Key usada en la cabecera x-api-key.">
                            <field name="peack_planing_client_validation_api_key" password="True"/>
                        </setting>

                        <setting id="peack_planing_client_validation_url_preview_setting" string="URL final de validacion" help="Vista previa de la URL usada para validar el estado del cliente.">
                            <field name="peack_planing_client_validation_url_preview" readonly="1"/>
                        </setting>

                        <setting id="peack_planing_support_url_preview_setting" string="URL final de soporte" help="Vista previa del enlace de soporte armado con la key de instancia.">
                            <field name="peack_planing_support_url_preview" readonly="1"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
