<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="peack_planing.ProductionFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button
                    type="button"
                    class="btn btn-secondary zrn_am_cp_back_btn"
                    t-on-click="backToReport"
                >
                    <i class="fa fa-arrow-left me-1"/>
                    Volver al reporte
                </button>
            </t>
        </xpath>
    </t>
</templates>
