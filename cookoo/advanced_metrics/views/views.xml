<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="advanced_metrics_inicio_default" model="advanced_metrics.inicio">
        <field name="name"> </field>
    </record>

    <record id="view_advanced_metrics_registro_tree" model="ir.ui.view">
        <field name="name">advanced_metrics.registro.tree</field>
        <field name="model">advanced_metrics.registro</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="descripcion"/>
            </tree>
        </field>
    </record>

    <record id="view_advanced_metrics_registro_form" model="ir.ui.view">
        <field name="name">advanced_metrics.registro.form</field>
        <field name="model">advanced_metrics.registro</field>
        <field name="arch" type="xml">
            <form string="Registro">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
   
    <record id="action_advanced_metrics_external_instance" model="ir.actions.act_url">
        <field name="name">Abrir instancia</field>
        <field name="url">https://www.odoo.com</field>
        <field name="target">new</field>
    </record>

    <record id="action_advanced_metrics_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de ventas e inventario</field>
        <field name="res_model" >advanced_metrics.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="view_advanced_metrics_inicio_form" model="ir.ui.view">
        <field name="name">advanced_metrics.inicio.form</field>
        <field name="model">advanced_metrics.inicio</field>
        <field name="arch" type="xml">
            <form string="Metricas Avanzadas" create="0" edit="0" delete="0" duplicate="0" class="zrn_advanced_metrics_home_form">
                    <field name="name" invisible="1"/>

                    <div class="zrn_advanced_metrics_dashboard">
                        <div class="zrn_advanced_metrics_header">
                            <h1>Metricas Avanzadas</h1>
                            <button
                                name="%(action_advanced_metrics_external_instance)d"
                                type="action"
                                string="Abrir Instancia"
                                class="btn btn-primary"
                            />
                        </div>

                        <div class="zrn_advanced_metrics_tile">
                            <h3>Ordenes de Venta</h3>
                            <p>
                                Genera reportes filtrando por fecha de entrega, cliente, orden de venta, producto, cantidad vendida e inventario disponible.
                            </p>
                            <div class="zrn_advanced_metrics_tile_actions">
                                <button
                                    name="%(action_advanced_metrics_report_wizard)d"
                                    type="action"
                                    string="Abrir"
                                    class="btn btn-primary"
                                />
                            </div>
                        </div>
                    </div>
            </form>
        </field>
    </record>

    <record id="action_advanced_metrics_inicio" model="ir.actions.act_window">
        <field name="name">Advanced Metrics</field>
        <field name="res_model">advanced_metrics.inicio</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_advanced_metrics_inicio_form"/>
        <field name="res_id" ref="advanced_metrics_inicio_default"/>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_advanced_metrics_root"
        name="Advanced Metrics"
        action="action_advanced_metrics_inicio"
        sequence="10"
    />

</odoo>