<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_metrics_api_config_tree" model="ir.ui.view">
        <field name="name">advanced_metrics.api.config.tree</field>
        <field name="model">advanced_metrics.api.config</field>
        <field name="arch" type="xml">
            <tree string="Configuraciones API">
                <field name="name"/>
                <field name="record_limit"/>
            </tree>
        </field>
    </record>

    <record id="view_advanced_metrics_api_config_form" model="ir.ui.view">
        <field name="name">advanced_metrics.api.config.form</field>
        <field name="model">advanced_metrics.api.config</field>
        <field name="arch" type="xml">
            <form string="API Configuration">
                <header>
                    <button name="action_generate_new_token" string="Generar Nuevo Token" type="object" class="btn-danger" confirm="Power BI perdera acceso hasta que actualices su conexion actual."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Acceso Mando Directivo"/></h1>
                    </div>
                    <group>
                        <group name="left_panel">
                            <field name="access_token"/>
                            <field name="record_limit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conexion Power BI" name="api_connection">
                            <group>
                                <field name="api_url" widget="CopyClipboardChar" readonly="1" string="URL segura"/>
                            </group>
                            <div class="alert alert-warning mt-3" role="alert">
                                <strong>Precaucion:</strong><br/>
                                Protege este Token como si fuera una contrasena. Cualquier persona con esta URL podra acceder a la data.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advanced_metrics_api_config" model="ir.actions.act_window">
        <field name="name">Configuracion API Power BI</field>
        <field name="res_model">advanced_metrics.api.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primera llave maestra de API</p>
        </field>
    </record>

    <!-- Hidden from the top menu; access is provided only from the validated dashboard -->
    <record id="menu_advanced_metrics_api_config" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
