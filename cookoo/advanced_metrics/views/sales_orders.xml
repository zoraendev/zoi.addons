<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_advanced_metrics_report_wizard_form" model="ir.ui.view">
        <field name="name">advanced_metrics.sales_orders.form</field>
        <field name="model">advanced_metrics.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Ordenes de venta" js_class="advanced_metrics_sales_orders_form" class="zrn_advanced_metrics_sales_orders_form" create="0" edit="0" delete="0" duplicate="0">
                <div class="zrn_advanced_metrics_sales_orders">
                    <div class="zrn_am_workspace">
                        <div class="zrn_am_filters_panel">
                            <div class="zrn_am_filters_title">Filtros</div>

                            <div class="zrn_am_filters">
                                <div class="zrn_am_date_card">
                                    <div class="zrn_am_date_meta">
                                        <div class="zrn_am_date_title">Fecha de entrega</div>
                                        <div class="zrn_am_date_range">
                                            <div class="zrn_am_date_item">
                                                <span class="zrn_am_date_item_label">De</span>
                                                <field name="fecha_entrega_desde" nolabel="1"/>
                                            </div>
                                            <div class="zrn_am_date_item">
                                                <span class="zrn_am_date_item_label">Hasta</span>
                                                <field name="fecha_entrega_hasta" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="zrn_am_customer_filter">
                                    <div class="zrn_am_customer_filter_label">Cliente</div>
                                    <field
                                        name="cliente_id"
                                        widget="res_partner_many2one"
                                        context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                        nolabel="1"
                                        options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                        placeholder="Selecciona un cliente"
                                    />
                                </div>

                                <div class="zrn_am_quick_filter">
                                    <a href="#" class="btn btn-outline-primary zrn_am_next_week_btn" role="button"
                                       title="Auto-llenar con las fechas del proximo lunes al domingo">
                                        <span class="fa fa-calendar-plus-o" aria-hidden="true"/>
                                        <span>Semana Siguiente</span>
                                    </a>
                                </div>

                                <div class="zrn_am_filter_actions">
                                    <a href="#" class="btn btn-primary zrn_am_generate_btn" role="button">
                                        Generar reporte
                                    </a>
                                    <a href="#" class="btn btn-secondary zrn_am_download_btn" role="button">
                                        <span class="fa fa-download" aria-hidden="true"/>
                                        <span>Descargar XLS</span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_am_results_panel">
                            <div class="zrn_am_table_shell">
                                <field name="report_line_ids" nolabel="1" readonly="1" widget="one2many" options="{'no_create': True, 'no_delete': True, 'no_edit': True}">
                                    <tree create="0" edit="0" delete="0">
                                        <field name="fecha_entrega" string="Fecha de entrega"/>
                                        <field name="dia_semana" string="Dia" optional="show"/>
                                        <field name="cliente_id" string="Cliente"/>
                                        <field name="numero_orden_venta" string="Numero de orden de venta"/>
                                        <field name="producto" string="Producto"/>
                                        <field name="cantidad_vendida" string="Cantidad vendida"/>
                                        <field name="inventario_disponible" string="Inventario disponible de producto terminado"/>
                                        <field name="cantidad_sugerida_producir" string="Cantidad sugerida a producir"/>
                                    </tree>
                                </field>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Action is now defined in views.xml to resolve circular dependency -->

    <record id="view_advanced_metrics_inicio_form_report_link" model="ir.ui.view">
        <field name="name">advanced_metrics.inicio.form.report.link</field>
        <field name="model">advanced_metrics.inicio</field>
        <field name="inherit_id" ref="advanced_metrics.view_advanced_metrics_inicio_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside"/>
        </field>
    </record>

</odoo>
