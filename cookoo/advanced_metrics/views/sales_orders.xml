<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_advanced_metrics_report_wizard_form" model="ir.ui.view">
        <field name="name">advanced_metrics.sales_orders.form</field>
        <field name="model">advanced_metrics.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Ordenes de venta" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_generate_report" type="object" string="Generar reporte" class="btn btn-primary"/>
                    <button name="action_clear_filters" type="object" string="Limpiar" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <group invisible="1">
                        <field name="name"/>
                        <field name="available_cliente_ids"/>
                        <field name="available_product_ids"/>
                    </group>

                    <group string="Filtros del reporte">
                        <group>
                            <field name="fecha_entrega_desde"/>
                            <field name="fecha_entrega_hasta"/>
                            <field name="sale_order_state" placeholder="Todos los estados"/>
                        </group>
                        <group>
                            <field
                                name="cliente_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', available_cliente_ids)]"
                                context="{'show_address': 1, 'show_vat': True}"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                placeholder="Selecciona uno o varios clientes"
                            />
                            <field
                                name="product_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', available_product_ids)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                placeholder="Selecciona uno o varios productos"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" type="object" string="Continuar" class="btn btn-primary"/>
                    <button name="action_clear_filters" type="object" string="Limpiar" class="btn btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_advanced_metrics_report_wizard_report_form" model="ir.ui.view">
        <field name="name">advanced_metrics.sales_orders.report.form</field>
        <field name="model">advanced_metrics.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Detalle del reporte" create="0" edit="0" delete="0" duplicate="0" class="zrn_advanced_metrics_sales_orders_form">
                <sheet>
                    <div class="zrn_am_report_screen">
                        <div class="zrn_am_report_screen_header">
                            <div>
                                <h2>Detalle operativo</h2>
                                <p>
                                    Vista agrupada por producto, cliente y orden de venta usando la seleccion definida en la pantalla anterior.
                                </p>
                                <p class="zrn_am_report_range">
                                    <field name="report_date_range_label" readonly="1" nolabel="1"/>
                                </p>
                            </div>
                            <div class="zrn_am_report_screen_stats">
                                <div class="zrn_am_report_stat_box">
                                    <span>Clientes</span>
                                    <strong><field name="report_customer_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>Productos</span>
                                    <strong><field name="report_product_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>OVs</span>
                                    <strong><field name="report_order_count" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="zrn_am_report_stat_box">
                                    <span>Lineas</span>
                                    <strong><field name="report_row_count" readonly="1" nolabel="1"/></strong>
                                </div>
                            </div>
                        </div>

                        <div class="zrn_am_report_table_panel">
                            <field name="report_html" widget="html" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_back_to_filters" type="object" string="Volver a filtros" class="btn btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action is now defined in views.xml to resolve circular dependency -->

    <record id="view_advanced_metrics_inicio_form_report_link" model="ir.ui.view">
        <field name="name">advanced_metrics.inicio.form.report.link</field>
        <field name="model">advanced_metrics.inicio</field>
        <field name="inherit_id" ref="advanced_metrics.view_advanced_metrics_inicio_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside"/>
        </field>
    </record>

</odoo>
