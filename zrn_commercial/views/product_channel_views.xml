<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_commercial_product_channel_search" model="ir.ui.view">
        <field name="name">zrn_commercial.product.channel.search</field>
        <field name="model">zrn_commercial.product.channel</field>
        <field name="arch" type="xml">
            <search string="Canales de producto">
                <field name="name"/>
                <field name="code"/>
                <field name="owner_user_id"/>
                <field name="usage_type"/>
                <filter string="Activos" name="active_true" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="active_false" domain="[('active', '=', False)]"/>
                <filter string="Inventario" name="usage_inventory" domain="[('usage_type', '=', 'inventory')]"/>
                <filter string="Comercial" name="usage_commercial" domain="[('usage_type', '=', 'commercial')]"/>
            </search>
        </field>
    </record>

    <record id="view_zrn_commercial_product_channel_list" model="ir.ui.view">
        <field name="name">zrn_commercial.product.channel.list</field>
        <field name="model">zrn_commercial.product.channel</field>
        <field name="arch" type="xml">
            <tree string="Canales de producto">
                <field name="active" optional="show"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="usage_type"/>
                <field name="product_count" string="Productos"/>
                <field name="min_stock_days" optional="show"/>
                <field name="target_stock_days" optional="show"/>
                <field name="max_stock_days" optional="show"/>
                <field name="owner_user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_commercial_product_channel_form" model="ir.ui.view">
        <field name="name">zrn_commercial.product.channel.form</field>
        <field name="model">zrn_commercial.product.channel</field>
        <field name="arch" type="xml">
            <form string="Canal de producto">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" string="Productos" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del canal de producto"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="usage_type"/>
                            <field name="owner_user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="min_stock_days"/>
                            <field name="target_stock_days"/>
                            <field name="max_stock_days"/>
                            <field name="product_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <group>
                                <field name="description" placeholder="Descripcion funcional del canal"/>
                                <field name="notes" placeholder="Notas internas"/>
                            </group>
                        </page>
                        <page string="Productos">
                            <field name="product_link_ids" context="{'default_channel_id': id}">
                                <tree editable="bottom" string="Productos asociados">
                                    <field name="available_product_tmpl_ids" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="default_code" readonly="1"/>
                                    <field name="categ_id" readonly="1"/>
                                    <field name="active" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                                <form string="Producto asociado">
                                    <group>
                                        <field name="available_product_tmpl_ids" invisible="1"/>
                                        <field name="product_tmpl_id"/>
                                        <field name="default_code" readonly="1"/>
                                        <field name="categ_id" readonly="1"/>
                                        <field name="active"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_template_form_zrn_product_channel" model="ir.ui.view">
        <field name="name">product.template.form.zrn.product.channel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="zrn_product_channel_id" options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_zrn_commercial_product_channels" model="ir.actions.act_window">
        <field name="name">Canales de producto</field>
        <field name="res_model">zrn_commercial.product.channel</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_zrn_commercial_product_channel_list"/>
        <field name="search_view_id" ref="view_zrn_commercial_product_channel_search"/>
        <field name="target">current</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
