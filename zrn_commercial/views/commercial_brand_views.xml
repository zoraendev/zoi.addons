<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_commercial_brand_list" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.brand.list</field>
        <field name="model">zrn_commercial.commercial.brand</field>
        <field name="arch" type="xml">
            <tree string="Marcas comerciales">
                <header>
                    <button name="%(action_zrn_commercial_brand_import_wizard)d" type="action" string="Importar marcas" class="btn-primary"/>
                </header>
                <field name="active" optional="show" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="commercial_status" widget="badge" optional="show"/>
                <field name="owner_name" optional="show"/>
                <field name="opportunity_count" string="Oportunidades" optional="show"/>
                <field name="quotation_count" string="Cotizaciones" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="product_count" string="Productos"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_commercial_brand_form" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.brand.form</field>
        <field name="model">zrn_commercial.commercial.brand</field>
        <field name="arch" type="xml">
            <form string="Marca comercial">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_opportunities" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="opportunity_count" string="Oportunidades" widget="statinfo"/>
                        </button>
                        <button name="action_open_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="customer_count" string="Clientes" widget="statinfo"/>
                        </button>
                        <button name="action_open_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="quotation_count" string="Cotizaciones" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la marca"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="commercial_status"/>
                            <field name="owner_name" placeholder="Empresa o grupo titular de la marca"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field
                                name="logo"
                                widget="image"
                                class="oe_avatar"
                                help="Formatos permitidos: PNG, JPG/JPEG o WEBP. Tamano maximo: 5 MB."
                            />
                            <field name="country_id"/>
                            <field name="launch_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="website"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <group>
                                <field name="description" placeholder="Descripcion de la marca"/>
                                <field name="playbook_notes" placeholder="Lineamientos comerciales, foco y uso interno"/>
                                <field name="notes" placeholder="Notas internas"/>
                            </group>
                            <group>
                                <field name="suggested_channel_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                                <field name="responsible_user_ids" widget="many2many_tags"/>
                                <field name="focus_product_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Productos">
                            <field name="product_link_ids" context="{'default_brand_id': id}">
                                <tree editable="bottom" string="Productos asociados">
                                    <field name="available_product_ids" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="default_code" readonly="1"/>
                                    <field name="categ_id" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="active" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                                <form string="Producto asociado">
                                    <group>
                                        <field name="available_product_ids" invisible="1"/>
                                        <field name="product_id"/>
                                        <field name="default_code" readonly="1"/>
                                        <field name="categ_id" readonly="1"/>
                                        <field name="uom_id" readonly="1"/>
                                        <field name="active"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Origen">
                            <group>
                                <field name="source_model_name" readonly="1"/>
                                <field name="source_record_name" readonly="1"/>
                                <field name="source_record_id" readonly="1"/>
                                <field name="source_sync_date" readonly="1"/>
                            </group>
                            <group>
                                <button name="action_sync_from_source" type="object" string="Sincronizar desde origen" class="btn-secondary" invisible="not source_record_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_commercial_brands" model="ir.actions.act_window">
        <field name="name">Marcas comerciales</field>
        <field name="res_model">zrn_commercial.commercial.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_zrn_commercial_brand_list"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera marca comercial
            </p>
            <p>
                Aqui podras registrar marcas comerciales y asociar productos vendibles para futuros comparativos de inventario, ventas y compras.
            </p>
        </field>
    </record>
</odoo>

