<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_commercial_brand_import_wizard_form" model="ir.ui.view">
        <field name="name">zrn_commercial.brand.import.wizard.form</field>
        <field name="model">zrn_commercial.brand.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar marcas comerciales">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="available_source_model_ids" invisible="1"/>
                            <field name="source_model_id" options="{'no_create_edit': True}" placeholder="Selecciona un catalogo con marcas"/>
                        </group>
                        <group>
                            <field name="detected_count" readonly="1"/>
                            <field name="selected_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_scan_sources" type="object" string="Detectar marcas" class="oe_stat_button" icon="fa-search"/>
                    </div>
                    <group>
                        <field name="import_line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0" string="Marcas detectadas">
                                <field name="selected"/>
                                <field name="source_name"/>
                                <field name="source_code" optional="show"/>
                                <field name="existing_brand_id" optional="show"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button name="action_import_selected" type="object" string="Importar seleccionadas" class="btn-primary"/>
                        <button name="action_import_all_pending" type="object" string="Importar pendientes" class="btn-secondary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_commercial_brand_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar marcas</field>
        <field name="res_model">zrn_commercial.brand.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_zrn_commercial_brand_import_wizard_form"/>
    </record>

</odoo>
