<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Registros por defecto para los modelos singleton de vista unica -->
    <record id="zrn_commercial_home_default" model="zrn_commercial.home">
        <field name="name">Zoraen Commercial</field>
        <field name="sequence">10</field>
        <field name="page_key">overview</field>
    </record>

    <record id="zrn_commercial_portfolio_default" model="zrn_commercial.portfolio">
        <field name="name">Portafolio Comercial</field>
    </record>

    <record id="zrn_commercial_pricing_default" model="zrn_commercial.pricing">
        <field name="name">Pricing Comercial</field>
    </record>

    <!-- Vista de formulario principal / Dashboard de Zoraen Commercial -->
    <record id="view_zrn_commercial_home_form" model="ir.ui.view">
        <field name="name">zrn_commercial.home.form</field>
        <field name="model">zrn_commercial.home</field>
        <field name="arch" type="xml">
            <form string="Zoraen Commercial" js_class="zrn_planning_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_planning_submodule_form zrn_planning_production_planning_form zrn_planning_home_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="page_key" invisible="1"/>
                    <field name="sequence" invisible="1"/>

                    <div class="zrn_planning_production_shell">
                        <!-- Seccion Hero con KPIs iniciales -->
                        <div class="zrn_planning_production_hero">
                            <div class="zrn_planning_production_hero_copy">
                                <div class="zrn_planning_production_kicker">Zoraen Commercial</div>
                                <div class="oe_title">
                                    <h1>Centro de planeacion comercial</h1>
                                </div>
                                <div class="zrn_planning_production_intro">
                                    Centro operativo comercial para coordinar marcas, portafolio de productos y precios sugeridos.
                                </div>
                            </div>
                            <div class="zrn_planning_production_quickstats">
                                <div class="zrn_planning_production_stat">
                                    <span class="zrn_planning_production_stat_label">Frentes</span>
                                    <span class="zrn_planning_production_stat_value">3</span>
                                </div>
                                <div class="zrn_planning_production_stat">
                                    <span class="zrn_planning_production_stat_label">Marcas</span>
                                    <span class="zrn_planning_production_stat_value">Activas</span>
                                </div>
                                <div class="zrn_planning_production_stat">
                                    <span class="zrn_planning_production_stat_label">Objetivo</span>
                                    <span class="zrn_planning_production_stat_value">Analisis</span>
                                </div>
                            </div>
                        </div>

                        <!-- Menu de frentes de trabajo y paneles genericos de relleno (placeholders) -->
                        <div class="zrn_planning_production_dashboard">
                            <div class="zrn_planning_production_actions">
                                <div class="zrn_planning_production_section_title">Frentes de trabajo comercial</div>
                                <div class="zrn_planning_production_menu">
                                    <button
                                        name="action_open_brands"
                                        type="object"
                                        icon="fa-tags"
                                        string="Marcas comerciales"
                                        class="btn zrn_planning_submodule_menu_btn zrn_planning_submodule_menu_btn_secondary"
                                    />
                                    <button
                                        name="action_open_portfolio"
                                        type="object"
                                        icon="fa-folder-open"
                                        string="Portafolio"
                                        class="btn zrn_planning_submodule_menu_btn zrn_planning_submodule_menu_btn_primary"
                                    />
                                    <button
                                        name="action_open_pricing"
                                        type="object"
                                        icon="fa-money"
                                        string="Pricing"
                                        class="btn zrn_planning_submodule_menu_btn zrn_planning_submodule_menu_btn_tertiary"
                                    />
                                </div>
                            </div>

                            <!-- Paneles de relleno genericos (placeholders) -->
                            <div class="zrn_planning_production_panels">
                                <div class="zrn_planning_production_panel zrn_planning_production_panel_wide">
                                    <div class="zrn_planning_production_panel_head">
                                        <span>Contexto operativo</span>
                                        <span>Canales y marcas</span>
                                    </div>
                                    <div class="zrn_planning_production_panel_body zrn_planning_production_placeholder_list">
                                        <div class="zrn_planning_production_placeholder_row"/>
                                        <div class="zrn_planning_production_placeholder_row"/>
                                        <div class="zrn_planning_production_placeholder_row"/>
                                        <div class="zrn_planning_production_placeholder_row"/>
                                    </div>
                                </div>

                                <div class="zrn_planning_production_panel">
                                    <div class="zrn_planning_production_panel_head">
                                        <span>Alertas</span>
                                        <span>Precios y margenes</span>
                                    </div>
                                    <div class="zrn_planning_production_panel_body zrn_planning_production_placeholder_map">
                                        <div class="zrn_planning_production_placeholder_blob"/>
                                        <div class="zrn_planning_production_placeholder_dot zrn_planning_production_placeholder_dot_1"/>
                                        <div class="zrn_planning_production_placeholder_dot zrn_planning_production_placeholder_dot_2"/>
                                        <div class="zrn_planning_production_placeholder_dot zrn_planning_production_placeholder_dot_3"/>
                                    </div>
                                </div>

                                <div class="zrn_planning_production_panel">
                                    <div class="zrn_planning_production_panel_head">
                                        <span>Seguimiento</span>
                                        <span>Desempeno de portafolio</span>
                                    </div>
                                    <div class="zrn_planning_production_panel_body zrn_planning_production_placeholder_chart">
                                        <div class="zrn_planning_production_placeholder_bars">
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                            <div/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de formulario para Portafolio (Marcador de posicion) -->
    <record id="view_zrn_commercial_portfolio_form" model="ir.ui.view">
        <field name="name">zrn_commercial.portfolio.form</field>
        <field name="model">zrn_commercial.portfolio</field>
        <field name="arch" type="xml">
            <form string="Portafolio Comercial" js_class="zrn_planning_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_planning_submodule_form zrn_planning_delivery_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_planning_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Inicio"
                            class="btn zrn_planning_back_btn"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>Portafolio Comercial</h1>
                    </div>
                    <div class="zrn_planning_building_state">
                        <div class="zrn_planning_building_loader" aria-hidden="true">
                            <span class="zrn_planning_building_loader_ring zrn_planning_building_loader_ring_outer"/>
                            <span class="zrn_planning_building_loader_ring zrn_planning_building_loader_ring_inner"/>
                            <span class="zrn_planning_building_loader_core"/>
                        </div>
                        <div class="zrn_planning_building_copy">
                            <div class="zrn_planning_building_kicker">Workspace en progreso</div>
                            <div class="zrn_planning_building_title">Estamos preparando esta vista</div>
                            <div class="zrn_planning_building_messages" aria-live="polite">
                                <span>Construyendo el catalogo de productos...</span>
                                <span>Coordinando marcas, categorias y canales...</span>
                                <span>Preparando widgets de analisis de ventas...</span>
                                <span>Dejando lista la experiencia operativa...</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de formulario para Pricing (Marcador de posicion) -->
    <record id="view_zrn_commercial_pricing_form" model="ir.ui.view">
        <field name="name">zrn_commercial.pricing.form</field>
        <field name="model">zrn_commercial.pricing</field>
        <field name="arch" type="xml">
            <form string="Pricing Comercial" js_class="zrn_planning_form" create="0" edit="0" delete="0" duplicate="0" class="zrn_planning_submodule_form zrn_planning_delivery_planning_form">
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="zrn_planning_submodule_nav">
                        <button
                            name="action_open_home"
                            type="object"
                            icon="fa-arrow-left"
                            string="Volver a Inicio"
                            class="btn zrn_planning_back_btn"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>Pricing Comercial</h1>
                    </div>
                    <div class="zrn_planning_building_state">
                        <div class="zrn_planning_building_loader" aria-hidden="true">
                            <span class="zrn_planning_building_loader_ring zrn_planning_building_loader_ring_outer"/>
                            <span class="zrn_planning_building_loader_ring zrn_planning_building_loader_ring_inner"/>
                            <span class="zrn_planning_building_loader_core"/>
                        </div>
                        <div class="zrn_planning_building_copy">
                            <div class="zrn_planning_building_kicker">Workspace en progreso</div>
                            <div class="zrn_planning_building_title">Estamos preparando esta vista</div>
                            <div class="zrn_planning_building_messages" aria-live="polite">
                                <span>Calculando politicas de precios y descuentos...</span>
                                <span>Analizando margenes operativos por canal...</span>
                                <span>Estructurando simuladores dinamicos...</span>
                                <span>Dejando lista la experiencia operativa...</span>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acciones de ventana -->
    <record id="action_zrn_commercial_home" model="ir.actions.act_window">
        <field name="name">Zoraen Commercial</field>
        <field name="res_model">zrn_commercial.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_commercial_home_form"/>
        <field name="res_id" ref="zrn_commercial_home_default"/>
        <field name="target">current</field>
    </record>

    <record id="action_zrn_commercial_portfolio" model="ir.actions.act_window">
        <field name="name">Portafolio Comercial</field>
        <field name="res_model">zrn_commercial.portfolio</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_commercial_portfolio_form"/>
        <field name="res_id" ref="zrn_commercial_portfolio_default"/>
        <field name="target">current</field>
    </record>

    <record id="action_zrn_commercial_pricing" model="ir.actions.act_window">
        <field name="name">Pricing Comercial</field>
        <field name="res_model">zrn_commercial.pricing</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zrn_commercial_pricing_form"/>
        <field name="res_id" ref="zrn_commercial_pricing_default"/>
        <field name="target">current</field>
    </record>

    <!-- Menu Principal y submenus -->
    <menuitem
        id="menu_zrn_commercial_root"
        name="Zoraen Commercial"
        sequence="70"
        action="action_zrn_commercial_home"
        web_icon="zrn_commercial,static/description/icon.png"
    />

    <menuitem
        id="menu_zrn_commercial_home"
        name="Inicio"
        parent="menu_zrn_commercial_root"
        action="action_zrn_commercial_home"
        sequence="5"
    />

    <menuitem
        id="menu_zrn_commercial_brands_sub"
        name="Marcas comerciales"
        parent="menu_zrn_commercial_root"
        action="action_zrn_commercial_brands"
        sequence="10"
    />

    <menuitem
        id="menu_zrn_commercial_portfolio"
        name="Portafolio"
        parent="menu_zrn_commercial_root"
        action="action_zrn_commercial_portfolio"
        sequence="20"
    />

    <menuitem
        id="menu_zrn_commercial_pricing"
        name="Pricing"
        parent="menu_zrn_commercial_root"
        action="action_zrn_commercial_pricing"
        sequence="30"
    />

</odoo>
