<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zrn_commercial_channel_search" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.channel.search</field>
        <field name="model">zrn_commercial.commercial.channel</field>
        <field name="arch" type="xml">
            <search string="Canales comerciales">
                <field name="name"/>
                <field name="code"/>
                <field name="owner_user_id"/>
                <filter string="Activos" name="active_true" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="active_false" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_zrn_commercial_channel_list" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.channel.list</field>
        <field name="model">zrn_commercial.commercial.channel</field>
        <field name="arch" type="xml">
            <tree string="Canales comerciales">
                <field name="active" optional="show"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="partner_count" string="Clientes / PDVs"/>
                <field name="opportunity_count" optional="show"/>
                <field name="quotation_count" optional="show"/>
                <field name="account_without_followup_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_zrn_commercial_channel_form" model="ir.ui.view">
        <field name="name">zrn_commercial.commercial.channel.form</field>
        <field name="model">zrn_commercial.commercial.channel</field>
        <field name="arch" type="xml">
            <form string="Canal comercial">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" string="Cuentas" widget="statinfo"/>
                        </button>
                        <button name="action_open_opportunities" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="opportunity_count" string="Oportunidades" widget="statinfo"/>
                        </button>
                        <button name="action_open_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="quotation_count" string="Cotizaciones" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del canal"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="owner_user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="partner_count" readonly="1"/>
                            <field name="opportunity_count" readonly="1"/>
                            <field name="quotation_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle">
                            <group>
                                <field name="description" placeholder="Descripcion funcional del canal"/>
                                <field name="notes" placeholder="Notas internas"/>
                            </group>
                        </page>
                        <page string="Clientes / PDVs">
                            <field name="partner_link_ids" context="{'default_channel_id': id}">
                                <tree editable="bottom" string="Clientes / PDVs asociados">
                                    <field name="available_partner_ids" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="commercial_partner_id" readonly="1"/>
                                    <field name="vat" readonly="1" optional="show"/>
                                    <field name="city" readonly="1" optional="show"/>
                                    <field name="state_id" readonly="1" optional="show"/>
                                    <field name="active" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </tree>
                                <form string="Cliente / PDV asociado">
                                    <group>
                                        <field name="available_partner_ids" invisible="1"/>
                                        <field name="partner_id"/>
                                        <field name="commercial_partner_id" readonly="1"/>
                                        <field name="vat" readonly="1"/>
                                        <field name="city" readonly="1"/>
                                        <field name="state_id" readonly="1"/>
                                        <field name="country_id" readonly="1"/>
                                        <field name="active"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zrn_commercial_channels" model="ir.actions.act_window">
        <field name="name">Canales comerciales</field>
        <field name="res_model">zrn_commercial.commercial.channel</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_zrn_commercial_channel_list"/>
        <field name="search_view_id" ref="view_zrn_commercial_channel_search"/>
        <field name="target">current</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer canal comercial
            </p>
            <p>
                Aqui podras registrar canales y asignar clientes o PDVs de forma exclusiva para consolidar reportes comerciales.
            </p>
        </field>
    </record>
</odoo>
