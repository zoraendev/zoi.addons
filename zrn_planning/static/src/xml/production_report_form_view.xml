<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zrn_planning.ProductionReportFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <span class="o_control_panel_status_indicator">
                    Lineas:
                    <t t-esc="model.root.data.report_row_count || 0"/>
                </span>
                <button
                    type="button"
                    class="btn btn-secondary"
                    t-on-click="downloadReportExcel"
                >
                    <i class="fa fa-download me-1"/>
                    Exportar
                </button>
                <button
                    type="button"
                    class="btn btn-primary"
                    t-on-click="openManufactureTable"
                >
                    <i class="fa fa-industry me-1"/>
                    Fabricar
                </button>
            </t>
        </xpath>
    </t>

    <t t-name="zrn_planning.ProductionManufactureFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button
                    type="button"
                    class="btn btn-primary"
                    t-on-click="createMfgPlan"
                >
                    <i class="fa fa-plus me-1"/>
                    Planear
                </button>
            </t>
        </xpath>
    </t>

    <t t-name="zrn_planning.PurchaseReportFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button
                    type="button"
                    class="btn btn-primary"
                    t-on-click="createSupplyPlan"
                >
                    <i class="fa fa-shopping-cart me-1"/>
                    Comprar
                </button>
            </t>
        </xpath>
    </t>
</templates>
