<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pbi_connections_external_instance" model="ir.actions.act_url">
        <field name="name">Abrir instancia</field>
        <field name="url">https://www.odoo.com</field>
        <field name="target">new</field>
    </record>

    <record id="pbi_connections_api_config_default" model="pbi_connections.api.config">
        <field name="name">Produccion</field>
        <field name="record_limit">5000</field>
    </record>

    <record id="view_pbi_connections_api_config_form" model="ir.ui.view">
        <field name="name">pbi_connections.api.config.form</field>
        <field name="model">pbi_connections.api.config</field>
        <field name="arch" type="xml">
            <form string="Configuracion API Power BI">
                <field name="show_dashboard" invisible="1"/>
                <field name="client_validation_state" invisible="1"/>
                <field name="client_status_code" invisible="1"/>
                <field name="support_url" invisible="1"/>
                <field name="client_validation_debug" invisible="1"/>
                <header>
                    <button
                        name="action_open_external_instance"
                        string="Abrir Instancia"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_request_support"
                        string="Contactar soporte"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        name="action_open_settings"
                        string="Settings"
                        type="object"
                        class="btn-secondary"
                    />
                    <button
                        name="action_generate_new_token"
                        string="Generar Nuevo Token"
                        type="object"
                        class="btn-danger"
                        confirm="Power BI perdera acceso hasta que actualices su conexion actual."
                    />
                </header>
                <div class="zrn_pbi_blocked_state" invisible="show_dashboard">
                    <div class="alert zrn_pbi_blocked_banner" role="alert">
                        <div class="zrn_pbi_blocked_banner_content">
                            <h3>
                                <field name="client_status_title" readonly="1" nolabel="1" class="oe_inline"/>
                            </h3>
                            <p>
                                <field name="client_status_message" readonly="1" nolabel="1" class="oe_inline"/>
                            </p>
                            <p class="text-muted" invisible="not client_validation_debug">
                                <field name="client_validation_debug" readonly="1" nolabel="1" class="oe_inline"/>
                            </p>
                            <div class="zrn_pbi_tile_actions zrn_pbi_center_actions">
                                <button
                                    name="action_request_support"
                                    type="object"
                                    string="Contactar soporte"
                                    class="btn btn-secondary"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <sheet invisible="not show_dashboard">
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej. Acceso Power BI Produccion"/>
                        </h1>
                    </div>
                    <div class="zrn_pbi_panel zrn_pbi_config_panel">
                        <div class="zrn_pbi_panel_section zrn_pbi_panel_section_summary">
                            <group>
                                <group name="left_panel">
                                    <field name="access_token"/>
                                    <field name="record_limit"/>
                                </group>
                            </group>
                        </div>
                        <div class="zrn_pbi_panel_section zrn_pbi_panel_section_connection">
                            <div class="zrn_pbi_section_label">Conexion Power BI</div>
                            <group>
                                <field name="api_url" widget="CopyClipboardChar" readonly="1" string="URL segura de referencia"/>
                            </group>
                            <div class="alert mt-3 zrn_pbi_help_callout zrn_pbi_help_callout_info" role="alert">
                                <strong>Uso recomendado:</strong><br/>
                                Utiliza el valor de <em>Token de Acceso</em> en la cabecera <code>Access-Token</code> o <code>Authorization: Bearer ...</code>.
                            </div>
                            <div class="alert mt-3 zrn_pbi_help_callout zrn_pbi_help_callout_warning" role="alert">
                                <strong>Precaucion:</strong><br/>
                                Protege este token como si fuera una contrasena. Cualquier persona con este valor podra consumir los endpoints publicados.
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pbi_connections_api_config" model="ir.actions.act_window">
        <field name="name">Credenciales API Power BI</field>
        <field name="res_model">pbi_connections.api.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pbi_connections_api_config_form"/>
        <field name="res_id" ref="pbi_connections_api_config_default"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Administra aqui el token principal de acceso.</p>
            <p>Esta es la unica vista operativa del modulo para gestionar la conexion de Power BI.</p>
        </field>
    </record>

    <record id="action_pbi_connections_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'pbi_connections'}</field>
    </record>

    <menuitem
        id="menu_pbi_connections_root"
        name="PBI Connections"
        action="action_pbi_connections_inicio"
        sequence="11"
    />

    <record id="menu_pbi_connections_endpoints" model="ir.ui.menu">
        <field name="name">Endpoints</field>
        <field name="parent_id" ref="menu_pbi_connections_root"/>
        <field name="action" ref="action_pbi_connections_endpoint"/>
        <field name="sequence">10</field>
        <field name="active" eval="False"/>
    </record>

    <record id="menu_pbi_connections_api_config" model="ir.ui.menu">
        <field name="name">Credenciales Power BI</field>
        <field name="parent_id" ref="menu_pbi_connections_root"/>
        <field name="action" ref="action_pbi_connections_api_config"/>
        <field name="sequence">20</field>
        <field name="active" eval="False"/>
    </record>

    <record id="menu_pbi_connections_settings" model="ir.ui.menu">
        <field name="name">Settings</field>
        <field name="parent_id" ref="menu_pbi_connections_root"/>
        <field name="action" ref="action_pbi_connections_settings"/>
        <field name="sequence">30</field>
    </record>
</odoo>
