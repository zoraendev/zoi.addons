<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advanced_metrics.ReportFormView" t-inherit="web.FormView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button
                    type="button"
                    class="btn btn-secondary me-2"
                    t-on-click="downloadReportExcel"
                >
                    <i class="fa fa-download me-1"/>
                    Descargar Excel
                </button>
                <button
                    type="button"
                    class="btn btn-primary zrn_am_cp_fabricar_btn"
                    t-on-click="openProductionSummary"
                >
                    <i class="fa fa-industry me-1"/>
                    Fabricar
                </button>
            </t>
        </xpath>
    </t>
</templates>
