<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_advanced_metrics" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.advanced_metrics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Advanced Metrics" name="advanced_metrics">
                    <block title="Credenciales de integracion" name="advanced_metrics_settings">
                        <setting id="advanced_metrics_instance_key_setting" string="Key de instancia" help="Clave usada para redireccionar a la instancia y al soporte en ADM.">
                            <field name="advanced_metrics_instance_key"/>
                        </setting>

                        <setting id="advanced_metrics_connection_base_url_setting" string="URL base de conexion" help="URL base del servicio, por ejemplo https://api.zoraen.com.">
                            <field name="advanced_metrics_connection_base_url"/>
                        </setting>

                        <setting id="advanced_metrics_connection_api_path_setting" string="Path de conexion" help="Path del endpoint para validar la conexion, por ejemplo /api/production/addons/vladdonconnection.">
                            <field name="advanced_metrics_connection_api_path"/>
                        </setting>

                        <setting id="advanced_metrics_connection_api_key_setting" string="API Key de conexion" help="API Key usada en la cabecera x-api-key.">
                            <field name="advanced_metrics_connection_api_key" password="True"/>
                        </setting>

                        <setting id="advanced_metrics_connection_addon_api_key_setting" string="Addon API Key" help="Valor usado en la cabecera x-addonapi-key.">
                            <field name="advanced_metrics_connection_addon_api_key" password="True"/>
                        </setting>

                        <setting id="advanced_metrics_connection_url_preview_setting" string="URL final de conexion" help="Vista previa de la URL usada para validar la conexion del addon.">
                            <field name="advanced_metrics_connection_url_preview" readonly="1"/>
                        </setting>

                        <setting id="advanced_metrics_support_url_preview_setting" string="URL final de soporte" help="Vista previa del enlace de soporte armado con la key de instancia.">
                            <field name="advanced_metrics_support_url_preview" readonly="1"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
