<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_customer_summary_tree" model="ir.ui.view">
        <field name="name">advanced_metrics.report.customer.summary.tree</field>
        <field name="model">advanced_metrics.report.wizard.report.customer.line</field>
        <field name="arch" type="xml">
            <tree string="Clientes del reporte" create="0" edit="0" delete="0" import="0" js_class="advanced_metrics_report_summary_list">
                <field name="first_delivery_date"/>
                <field name="last_delivery_date"/>
                <field name="partner_id" string="Punto de venta"/>
                <field name="customer_id" string="Cliente"/>
                <field name="city"/>
                <field name="order_count"/>
                <field name="line_count"/>
                <field name="product_count"/>
                <field name="total_units" sum="Total unidades"/>
                <field name="phone"/>
                <field name="email" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_report_customer_summary_form" model="ir.ui.view">
        <field name="name">advanced_metrics.report.customer.summary.form</field>
        <field name="model">advanced_metrics.report.wizard.report.customer.line</field>
        <field name="arch" type="xml">
            <form string="Detalle del punto de venta" create="0" edit="0" delete="0">
                <header>
                    <button name="action_return_to_report" type="object" string="Regresar al reporte" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="customer_id" readonly="1"/>
                        </div>
                    </div>
                    <group string="Resumen operativo">
                        <group>
                            <field name="first_delivery_date" readonly="1"/>
                            <field name="last_delivery_date" readonly="1"/>
                            <field name="city" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                        <group>
                            <field name="order_count" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="product_count" readonly="1"/>
                            <field name="total_units" readonly="1"/>
                        </group>
                    </group>
                    <group string="Lineas incluidas en el reporte">
                        <field name="report_detail_line_ids" readonly="1" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="fecha_entrega"/>
                                <field name="dia_semana"/>
                                <field name="order_id"/>
                                <field name="product_id"/>
                                <field name="cantidad_vendida"/>
                                <field name="inventario_disponible"/>
                                <field name="inventario_libre_usar"/>
                                <field name="cantidad_sugerida_producir"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advanced_metrics_report_customers" model="ir.actions.act_window">
        <field name="name">Clientes del reporte</field>
        <field name="res_model">advanced_metrics.report.wizard.report.customer.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="advanced_metrics.view_report_customer_summary_tree"/>
        <field name="domain">[('wizard_id', '=', context.get('active_id'))]</field>
        <field name="context">{'search_default_group_by_customer_id': 0}</field>
        <field name="target">current</field>
    </record>

    <record id="view_report_product_summary_tree" model="ir.ui.view">
        <field name="name">advanced_metrics.report.product.summary.tree</field>
        <field name="model">advanced_metrics.report.wizard.report.product.line</field>
        <field name="arch" type="xml">
            <tree string="Productos del reporte" create="0" edit="0" delete="0" import="0" js_class="advanced_metrics_report_summary_list">
                <field name="first_delivery_date"/>
                <field name="last_delivery_date"/>
                <field name="product_id" string="Producto"/>
                <field name="default_code"/>
                <field name="categ_name"/>
                <field name="customer_count"/>
                <field name="order_count"/>
                <field name="line_count"/>
                <field name="total_units" sum="Total demanda"/>
                <field name="stock_initial" sum="Stock inicial"/>
                <field name="stock_free" sum="Stock libre"/>
                <field name="suggested_production" sum="Sugerido fabricar"/>
                <field name="projected_balance" sum="Saldo proyectado"/>
            </tree>
        </field>
    </record>

    <record id="view_report_product_summary_form" model="ir.ui.view">
        <field name="name">advanced_metrics.report.product.summary.form</field>
        <field name="model">advanced_metrics.report.wizard.report.product.line</field>
        <field name="arch" type="xml">
            <form string="Detalle del producto" create="0" edit="0" delete="0">
                <header>
                    <button name="action_return_to_report" type="object" string="Regresar al reporte" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="default_code" readonly="1"/>
                            <span> | </span>
                            <field name="categ_name" readonly="1"/>
                        </div>
                    </div>
                    <group string="Resumen operativo">
                        <group>
                            <field name="first_delivery_date" readonly="1"/>
                            <field name="last_delivery_date" readonly="1"/>
                            <field name="customer_count" readonly="1"/>
                            <field name="order_count" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_units" readonly="1"/>
                            <field name="stock_initial" readonly="1"/>
                            <field name="stock_free" readonly="1"/>
                            <field name="suggested_production" readonly="1"/>
                            <field name="projected_balance" readonly="1"/>
                        </group>
                    </group>
                    <group string="Lineas incluidas en el reporte">
                        <field name="report_detail_line_ids" readonly="1" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="fecha_entrega"/>
                                <field name="dia_semana"/>
                                <field name="cliente_id"/>
                                <field name="order_id"/>
                                <field name="cantidad_vendida"/>
                                <field name="inventario_disponible"/>
                                <field name="inventario_libre_usar"/>
                                <field name="cantidad_sugerida_producir"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advanced_metrics_report_products" model="ir.actions.act_window">
        <field name="name">Productos del reporte</field>
        <field name="res_model">advanced_metrics.report.wizard.report.product.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="advanced_metrics.view_report_product_summary_tree"/>
        <field name="domain">[('wizard_id', '=', context.get('active_id'))]</field>
        <field name="context">{}</field>
        <field name="target">current</field>
    </record>

    <record id="view_report_order_summary_tree" model="ir.ui.view">
        <field name="name">advanced_metrics.report.order.summary.tree</field>
        <field name="model">advanced_metrics.report.wizard.report.order.line</field>
        <field name="arch" type="xml">
            <tree string="OVs del reporte" create="0" edit="0" delete="0" import="0" js_class="advanced_metrics_report_summary_list">
                <field name="first_delivery_date"/>
                <field name="last_delivery_date"/>
                <field name="order_id"/>
                <field name="customer_id" string="Punto de venta"/>
                <field name="state_label" string="Estado"/>
                <field name="product_count"/>
                <field name="line_count"/>
                <field name="total_units" sum="Total unidades"/>
            </tree>
        </field>
    </record>

    <record id="view_report_order_summary_form" model="ir.ui.view">
        <field name="name">advanced_metrics.report.order.summary.form</field>
        <field name="model">advanced_metrics.report.wizard.report.order.line</field>
        <field name="arch" type="xml">
            <form string="Detalle de la orden de venta" create="0" edit="0" delete="0">
                <header>
                    <button name="action_return_to_report" type="object" string="Regresar al reporte" class="btn btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="order_id" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="customer_id" readonly="1"/>
                            <span> | </span>
                            <field name="state_label" readonly="1"/>
                        </div>
                    </div>
                    <group string="Resumen operativo">
                        <group>
                            <field name="first_delivery_date" readonly="1"/>
                            <field name="last_delivery_date" readonly="1"/>
                            <field name="product_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="total_units" readonly="1"/>
                        </group>
                    </group>
                    <group string="Lineas incluidas en el reporte">
                        <field name="report_detail_line_ids" readonly="1" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="fecha_entrega"/>
                                <field name="dia_semana"/>
                                <field name="cliente_id"/>
                                <field name="product_id"/>
                                <field name="cantidad_vendida"/>
                                <field name="inventario_disponible"/>
                                <field name="inventario_libre_usar"/>
                                <field name="cantidad_sugerida_producir"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advanced_metrics_report_orders" model="ir.actions.act_window">
        <field name="name">OVs del reporte</field>
        <field name="res_model">advanced_metrics.report.wizard.report.order.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="advanced_metrics.view_report_order_summary_tree"/>
        <field name="domain">[('wizard_id', '=', context.get('active_id'))]</field>
        <field name="context">{}</field>
        <field name="target">current</field>
    </record>

</odoo>
